# Copy this file to tools/.env and edit it there. The local .env is the single
# configuration source for rendering and building template artifacts.
# Values are shell-like KEY=value entries, but commands are not evaluated.
# Values containing spaces must be quoted.

# --- Guest site configuration (substituted into the cloud-config) ---

# Network bridge. On a VLAN trunk you still have to add the tag later.
BRIDGE=vmbr0

# Remote syslog collector used by the remote-syslog profiles. Those profiles
# are RAM-only: if this collector is unreachable, the VM keeps no durable log.
# The -local profiles ignore these values and retain logs on their VM disks.
SYSLOG_SERVER=10.10.10.10
SYSLOG_PORT=514

# Must include IPv4 and IPv6 loopback.
FAIL2BAN_IGNORE_IPS='127.0.0.1/8 ::1 10.10.10.100 10.10.10.101'

# IANA timezone for the guest.
TIMEZONE=America/Chicago

# APPDATA disk identity. Every profile refuses to format any disk that does not
# match both of these. No need to change them.
APPDATA_WWN=0x2000000000000001
APPDATA_SERIAL=APPDATA

# --- Template identities and local build inputs ---

# First VM ID. Each profile in profiles.yaml claims VMID_START + its offset.
VMID_START=9000

# Prefix for template names, e.g. kasa-deb13-base.
NAME_PREFIX=kasa

# Public key file for SSH access to the built VMs. Keep it outside this repo.
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Where generated template files land. Safe to delete at any time.
ARTIFACT_OUTPUT_DIR=./build

# --- Destination storage on Proxmox ---

# Proxmox resolves the snippets directory from this storage name, so there is
# no path to keep in sync.
SNIPPET_STORAGE_NAME=local
ISO_STORAGE_PATH=/var/lib/vz/template/iso
VM_STORAGE_NAME=local

# --- VM sizing ---

CPU=4
MEM_MIN=1024
MEM_MAX=4096
ROOT_DISK_SIZE=8
APPDATA_DISK_SIZE=16
