# Copy this file to tools/.env and edit it there. The local .env is the single
# configuration source for rendering and building template artifacts.
# Values are shell-like KEY=value entries, but commands are not evaluated.
# Values containing spaces must be quoted.

# --- Guest site configuration (substituted into the cloud-config) ---

# Network bridge.
BRIDGE=vmbr0

# Optional VLAN ID for the VM NIC, 1-4094. An empty tag leaves the interface
# untagged on BRIDGE, which is right for an access port and wrong for a trunk:
# on a trunk the guest comes up with a link and no network, which reads as a
# cloud-init failure rather than a missing tag. LXC_VLAN_TAG below is the
# container counterpart and is set separately.
VLAN_TAG=''

# Remote syslog collector used by the remote-syslog profiles. On those profiles
# the journal is volatile and the forwarding queue is memory-only, so if this
# collector is unreachable the system log stream is lost rather than spooled.
# The profiles without -syslog ignore these values and keep Debian's normal
# disk-backed syslog instead.
SYSLOG_SERVER=10.10.10.10
SYSLOG_PORT=514

# Must include IPv4 and IPv6 loopback.
FAIL2BAN_IGNORE_IPS='127.0.0.1/8 ::1 10.10.10.100 10.10.10.101'

# Optional exact admin SSH source addresses, separated by spaces. Public
# examples: admin@10.10.10.100 and admin@192.168.1.100. The default is empty so
# copying this file never activates example addresses as authorization.
SSH_ALLOW_USERS=''

# IANA timezone for the guest.
TIMEZONE=America/Chicago

# APPDATA disk identity. Every profile refuses to format any disk that does not
# match both of these. No need to change them.
APPDATA_WWN=0x2000000000000001
APPDATA_SERIAL=APPDATA

# --- Template identities and local build inputs ---

# First VM ID. Each profile in templates/profiles.yaml claims VMID_START + its offset.
VMID_START=9000

# Prefix for template names, e.g. kasa-deb13-base.
NAME_PREFIX=kasa

# Public key file for SSH access to the built VMs. Keep it outside this repo.
#
# One key per line; every key in the file is injected, so a fleet with more than one
# operator or control host needs no second build. A relative path is resolved against
# this file's directory, not the repository root -- `./keys.pub`, not `./tools/keys.pub`.
#
# May be empty when SSH_USER_CA_PUBLIC_KEY is set, which builds a template reachable only
# by certificate. Empty with no CA is refused: that template could authenticate nobody.
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# --- Trust anchors (optional; omit either to build without it) ---
#
# Both are public material and neither is a credential. Nothing secret belongs in a
# cloud-init payload: the vendor-data snippet is shared by every clone of a template, it
# stays readable through `qm cloudinit dump` and /var/lib/cloud/ on the guest, and secret
# values belong in the registered secret manager and reach a host at runtime.

# SSH user CA public key, installed as /etc/ssh/kasa_user_ca.pub with a
# TrustedUserCAKeys drop-in, so a host accepts short-lived user certificates from its
# first boot rather than after a configuration run that has to reach it first.
#
# This is the CA *public* half. The signing key is generated inside the vault and never
# leaves it. A signed certificate is not a CA key and is rejected.
#
# The default is empty so copying this file never activates a trust anchor.
SSH_USER_CA_PUBLIC_KEY=''

# Internal root CA certificate, added to the guest system trust store so it can validate
# certificates issued by the internal PKI. Exactly one PEM certificate, not a chain.
#
# Names a path outside this repository on purpose: certificate files are blocked at the
# remote, and nothing here should hold one.
KASA_ROOT_CA_FILE=''

# Where generated template files land. Safe to delete at any time.
ARTIFACT_OUTPUT_DIR=./build

# --- Destination storage on Proxmox ---

# Proxmox resolves the snippets directory from this storage name, so there is
# no path to keep in sync.
SNIPPET_STORAGE_NAME=local
ISO_STORAGE_PATH=/var/lib/vz/template/iso
VM_STORAGE_NAME=local

# --- VM sizing ---

CPU=4
MEM_MIN=1024
MEM_MAX=4096
ROOT_DISK_SIZE=8
APPDATA_DISK_SIZE=16

# --- LXC containers (optional; the defaults shown here apply if omitted) ---
#
# These are the only LXC-specific inputs. Everything else a container needs --
# BRIDGE, TIMEZONE, SYSLOG_SERVER, SYSLOG_PORT, FAIL2BAN_IGNORE_IPS and
# SSH_ALLOW_USERS -- is shared with the VM templates and is not repeated here.
#
# Unlike the keys above, every LXC_ key is optional: leaving it out selects the
# default below rather than failing the build, so an existing .env written
# before LXC support keeps working untouched.

# First container ID. Each profile claims LXC_CTID_START + its vmid_offset.
# Proxmox shares one numberspace between VMs and containers, so this range must
# not overlap VMID_START; the build refuses if it does.
LXC_CTID_START=9100

# Proxmox storage names, not paths. LXC_TEMPLATE_STORAGE holds the downloaded
# container template; LXC_APPDATA_STORAGE backs the mp0 volume mounted at
# /mnt/appdata on every profile.
#
# Check these against your node. A container rootfs and mount point need storage
# that accepts 'rootdir' content, and on a standard install 'local' does not: it
# carries only iso, vztmpl and backup. 'local-lvm' is Proxmox's default rootdir
# storage on an LVM install, 'local-zfs' on a ZFS one. Run
# `pvesm status --content rootdir` to see what your node offers. The generated
# create script checks this before touching anything, so a wrong value fails
# with a clear message rather than part-way through pct create.
LXC_TEMPLATE_STORAGE=local
LXC_ROOTFS_STORAGE=local-lvm
LXC_APPDATA_STORAGE=local-lvm

# Container sizing, in GiB for the disks and MiB for memory. Proxmox owns a
# container's RAM and swap limits, so these are set on the host at create time
# and there is no zram inside the container.
LXC_ROOT_DISK_SIZE=8
LXC_APPDATA_DISK_SIZE=16
LXC_CPU=2
LXC_MEMORY=2048
LXC_SWAP=512

# Optional. An empty VLAN tag leaves the container untagged on BRIDGE, and an
# empty nameserver lets Proxmox inherit the host's resolver, which is the right
# default for a DHCP container.
LXC_VLAN_TAG=''
LXC_NAMESERVER=''
