#cloud-config
# Generated by tools/build.py; edit the template, not this file.
# Profile: @@PROFILE_NAME@@ — @@PROFILE_DESCRIPTION@@

final_message: "cloud-init modules finished after $UPTIME seconds; check cloud-init status --long"

preserve_hostname: false
create_hostname_file: true
manage_etc_hosts: true
timezone: @@TIMEZONE@@

ssh_pwauth: false
disable_root: true

#% if kasa_root_ca
# The KASA internal root CA, so this guest can validate certificates issued by the
# internal PKI without per-service configuration. Public material: the private half is
# generated inside OpenBao and never leaves it.
#
# cloud-init's own module rather than a write_files plus update-ca-certificates in
# cloud-init-finalize: it runs in cloud_init_modules, well before the package and runcmd
# stages, so anything later in this same boot already sees the anchor.
#
# remove_defaults is deliberately absent. Setting it drops Debian's CA bundle, which
# breaks apt over HTTPS and every fetch in the rest of this boot.
ca_certs:
  trusted:
    - |
      @@KASA_ROOT_CA_PEM@@
#% endif

# The cloud-init mounts module is the sole owner of this mount. bootcmd only
# validates or creates the filesystem so the same target cannot be mounted twice.
# Deliberately not nosuid: container image layers legitimately ship setuid
# binaries, and blocking them on the data-root breaks images in confusing ways.
mounts:
  - ["/dev/disk/by-id/wwn-@@APPDATA_WWN@@", /mnt/appdata, ext4, "defaults,noatime,x-systemd.growfs,nodev,x-systemd.device-timeout=30s", "0", "2"]

bootcmd:
#% if docker
  # Mask before the Docker packages install, so the rootful daemon never starts
  # and never creates /var/log/docker or /var/lib/docker. Masking a unit that
  # does not exist yet is fine; dpkg's systemd helper skips masked units.
  - systemctl mask docker.service docker.socket
#% endif
  - |
    set -eu

    app_link=/dev/disk/by-id/wwn-@@APPDATA_WWN@@
    udevadm settle
    [ -L "$app_link" ] || {
      echo "APPDATA disk is missing: expected $app_link" >&2
      exit 1
    }

    app_dev="$(readlink -f "$app_link")"
    [ -b "$app_dev" ] || {
      echo "APPDATA target is not a block device: $app_dev" >&2
      exit 1
    }

    app_serial="$(lsblk -dn -o SERIAL "$app_dev" | xargs)"
    [ "$app_serial" = "@@APPDATA_SERIAL@@" ] || {
      echo "APPDATA serial mismatch on $app_dev: $app_serial" >&2
      exit 1
    }

    root_source="$(findmnt -n -o SOURCE /)"
    root_chain="$(lsblk -s -n -o PATH "$root_source")" || {
      echo "Could not inspect the root filesystem device chain" >&2
      exit 1
    }
    if printf '%s\n' "$root_chain" | grep -Fxq -- "$app_dev"; then
      echo "Refusing to format a device in the root filesystem chain: $app_dev" >&2
      exit 1
    fi

    app_tree="$(lsblk -nr -o TYPE "$app_dev")" || {
      echo "Could not inspect APPDATA device children: $app_dev" >&2
      exit 1
    }
    app_children="$(printf '%s\n' "$app_tree" | sed -n '2,$p')"
    if [ -n "$app_children" ]; then
      echo "Refusing APPDATA device with child partitions: $app_dev" >&2
      exit 1
    fi

    app_fstype="$(blkid -p -s TYPE -o value "$app_dev" 2>/dev/null || true)"
    app_label="$(blkid -p -s LABEL -o value "$app_dev" 2>/dev/null || true)"
    app_pttype="$(blkid -p -s PTTYPE -o value "$app_dev" 2>/dev/null || true)"
    [ -z "$app_pttype" ] || {
      echo "Refusing APPDATA device with partition table type $app_pttype" >&2
      exit 1
    }

    if [ -z "$app_fstype" ]; then
      app_signatures="$(wipefs -n --noheadings --output TYPE "$app_dev")" || {
        echo "Could not inspect APPDATA signatures: $app_dev" >&2
        exit 1
      }
      if [ -n "$app_signatures" ]; then
        echo "Refusing APPDATA device with an unrecognized signature: $app_dev" >&2
        exit 1
      fi
      mkfs.ext4 -F -L APPDATA "$app_dev"
    elif [ "$app_fstype" != ext4 ] || [ "$app_label" != APPDATA ]; then
      echo "APPDATA must be ext4 with label APPDATA; found type=$app_fstype label=$app_label" >&2
      exit 1
    fi

    install -d -m 0755 /mnt/appdata

write_files:
  # Provenance. Template names carry no version, so this file is how a running
  # agent says which build it came from.
  - path: /etc/kasa-image-release
    owner: root:root
    permissions: "0644"
    content: |
      ID=@@PROFILE_NAME@@
      DESCRIPTION=@@PROFILE_DESCRIPTION@@
      RELEASE=@@RELEASE@@
      OS=@@OS@@
      OS_VERSION=@@OS_VERSION@@
      OS_CODENAME=@@OS_CODENAME@@
      IMAGE_BUILD=@@IMAGE_BUILD@@
      SOURCE_COMMIT=@@SOURCE_COMMIT@@
      SOURCE_TREE_DIRTY=@@SOURCE_TREE_DIRTY@@
      BUILT_AT=@@BUILT_AT@@

  - path: /etc/ssh/sshd_config.d/99-harden.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      @@SSH_ALLOW_USERS_DIRECTIVE@@
      AuthenticationMethods publickey
      KbdInteractiveAuthentication no
      PermitUserEnvironment no
      AllowAgentForwarding no
      X11Forwarding no
      PrintLastLog yes
      MaxAuthTries 3
      LoginGraceTime 30s
      MaxSessions 5
      MaxStartups 10:30:100

#% if ssh_user_ca
  # Trust for the KASA SSH user CA, so a host is reachable with a short-lived
  # certificate from its first boot instead of after a configuration run that has to
  # reach it first. The CA public key is not secret and is distributed on purpose; the
  # signing key is generated inside OpenBao and never leaves it.
  #
  # These two paths and this file's contents must stay identical to
  # kasa-ansible/roles/kasa_ssh_ca, which writes the same files on the same hosts. A
  # difference makes that role rewrite them and reload sshd on every new host.
  #
  # 60- rather than 99-: 99-harden.conf above is this template's, and OpenSSH takes the
  # first value it sees for most keywords. Nothing here overlaps it, and the numeric gap
  # keeps the ownership boundary obvious.
  - path: /etc/ssh/kasa_user_ca.pub
    owner: root:root
    permissions: "0644"
    content: |
      @@SSH_USER_CA_PUBLIC_KEY@@

  # Exactly one directive. AllowUsers, AuthenticationMethods and the rest of the
  # hardening belong to 99-harden.conf, whose source of truth is SSH_ALLOW_USERS in
  # tools/.env. Emitting any of them here would fork that.
  - path: /etc/ssh/sshd_config.d/60-kasa-user-ca.conf
    owner: root:root
    permissions: "0644"
    content: |
      # KASA SSH user CA trust. Written by kasa-cloud-init at first boot and converged by
      # kasa-ansible roles/kasa_ssh_ca. Do not edit on the host.
      #
      # Two owners, one byte-identical file, deliberately: a host built from a CA-configured
      # template already has this, and any difference here would make the role rewrite it and
      # reload sshd on every new host. Change one and change the other.
      #
      # This file carries one directive. AllowUsers, AuthenticationMethods and the rest of
      # the hardening live in 99-harden.conf, whose source of truth is SSH_ALLOW_USERS in
      # kasa-cloud-init/tools/.env. Emitting any of them here would fork that.
      TrustedUserCAKeys /etc/ssh/kasa_user_ca.pub
#% endif

  # Do not add a user namespace restriction here (user.max_user_namespaces=0 or
  # kernel.apparmor_restrict_unprivileged_userns=1). Debian 13 leaves
  # unprivileged user namespaces open, and the docker profile's rootless
  # daemon depends on them. Restricting them breaks Docker on this image.
  # Debian's /usr/lib/sysctl.d/50-default.conf sets rp_filter after lower-sorting
  # files, so this drop-in must sort later for the strict values to be effective.
  - path: /etc/sysctl.d/60-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      kernel.kptr_restrict = 2
      kernel.yama.ptrace_scope = 1
      kernel.unprivileged_bpf_disabled = 1
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.*.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.*.send_redirects = 0
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.tcp_syncookies = 1
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv6.conf.*.accept_redirects = 0

  # zram is the only swap device, so swapping is cheap and should be preferred
  # over reclaiming page cache.
  - path: /etc/sysctl.d/99-cloud-tuning.conf
    owner: root:root
    permissions: "0644"
    content: |
      vm.swappiness = 100
      vm.page-cluster = 0

  - path: /etc/fail2ban/jail.local
    owner: root:root
    permissions: "0644"
    content: |
      [DEFAULT]
      bantime = 30m
      findtime = 15m
      maxretry = 5
      bantime.increment = true
      bantime.factor = 4
      bantime.overalljails = true
      bantime.rndtime = 10m
      backend = systemd
      banaction = nftables-multiport
      banaction_allports = nftables-allports
      ignoreip = @@FAIL2BAN_IGNORE_IPS@@

      [sshd]
      enabled = true
      port = ssh
      filter = sshd[mode=aggressive]

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    owner: root:root
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /etc/apt/apt.conf.d/80-cloud-init-retries
    owner: root:root
    permissions: "0644"
    content: |
      Acquire::Retries "5";
      Acquire::http::Timeout "30";
      Acquire::https::Timeout "30";
      DPkg::Lock::Timeout "120";

  - path: /etc/systemd/zram-generator.conf
    owner: root:root
    permissions: "0644"
    content: |
      [zram0]
      zram-size = min(ram / 2, 512)
      compression-algorithm = zstd
      swap-priority = 150

#% if remote_syslog
  # --- Volatile journal + remote forwarding -----------------------------
  # The collector is the only durable copy of the journal and syslog stream.
  # /var/log itself stays persistent, so packages that create a log directory
  # at install time keep it across reboot; anything writing files there
  # directly, including cloud-init's own logs, is durable on disk.

  - path: /etc/systemd/journald.conf.d/60-remote-syslog.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Journal]
      Storage=volatile
      RuntimeMaxUse=64M
      ForwardToSyslog=no
      RateLimitIntervalSec=30s
      RateLimitBurst=5000

  # imjournal needs /run/rsyslog to exist before rsyslog starts, and rsyslog is
  # socket-activated through syslog.socket, so start ordering cannot be assumed.
  # RuntimeDirectory creates it immediately before every start regardless of the
  # trigger; Preserve keeps the journal cursor across a service restart, without
  # which rsyslog would re-forward the whole journal to the collector.
  - path: /etc/systemd/system/rsyslog.service.d/10-runtime-dir.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      RuntimeDirectory=rsyslog
      RuntimeDirectoryMode=0700
      RuntimeDirectoryPreserve=yes

  # fail2ban logs to a file and keeps its ban database under /var by default.
  # SYSTEMD-JOURNAL gets its output forwarded to the collector instead, and the
  # database moves to /run so no ban state is written to disk. Bans do not
  # survive a reboot.
  - path: /etc/fail2ban/fail2ban.local
    owner: root:root
    permissions: "0644"
    content: |
      [Definition]
      logtarget = SYSTEMD-JOURNAL
      dbfile = /run/fail2ban/fail2ban.sqlite3

  # The receiver is rendered from the tracked site configuration.
  - path: /etc/rsyslog.d/01-remote.conf
    owner: root:root
    permissions: "0644"
    content: |
      # An absolute StateFile keeps the cursor out of Debian's $WorkDirectory,
      # which is /var/spool/rsyslog. Overriding workDirectory globally from an
      # included file would reach the whole daemon and degrade silently when the
      # target is missing at startup, so leave it alone instead.
      # Keep protection against journal replay loops and runaway producers, but
      # use an explicit one-minute window suitable for container log bursts.
      module(
        load="imjournal"
        StateFile="/run/rsyslog/imjournal.state"
        Ratelimit.Interval="60"
        Ratelimit.Burst="25000"
      )

      action(
        type="omfwd"
        target="@@SYSLOG_SERVER@@"
        port="@@SYSLOG_PORT@@"
        protocol="tcp"
        StreamDriver="gtls"
        StreamDriverMode="1"
        StreamDriverAuthMode="x509/name"
        StreamDriverPermittedPeers="@@SYSLOG_TLS_NAME@@"
        StreamDriver.CAFile="/etc/ssl/certs/ca-certificates.crt"
        StreamDriver.PrioritizeSAN="on"
        StreamDriver.CheckExtendedKeyPurpose="on"
        TCP_Framing="traditional"
        template="RSYSLOG_SyslogProtocol23Format"
        action.resumeRetryCount="-1"
        action.resumeInterval="30"
        # No queue.filename: naming a file is what makes a queue disk-assisted.
        # RAM is the only buffer, so an unreachable collector drops messages
        # rather than spooling them, lowest severity first.
        queue.type="LinkedList"
        queue.size="25000"
        queue.highWatermark="20000"
        queue.lowWatermark="5000"
        queue.timeoutEnqueue="0"
        queue.saveOnShutdown="off"
        queue.discardMark="24000"
        queue.discardSeverity="7"
      )

      # Do not continue into Debian's default on-disk /var/log actions.
      stop
#% endif

#% if docker
  # --- Rootless Docker --------------------------------------------------
  # Docker release key fingerprint: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
  - path: /etc/apt/keyrings/docker.asc
    owner: root:root
    permissions: "0644"
    content: |
      @@DOCKER_GPG_KEY@@

  - path: /etc/apt/sources.list.d/docker.sources
    owner: root:root
    permissions: "0644"
    content: |
      Types: deb
      URIs: https://download.docker.com/linux/debian
      Suites: trixie
      Components: stable
      Architectures: amd64
      Signed-By: /etc/apt/keyrings/docker.asc

  # Without delegation, cgroup v2 resource limits (--cpus, --memory) are
  # silently ignored for rootless containers.
  - path: /etc/systemd/system/user@.service.d/10-delegate.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      Delegate=cpu cpuset io memory pids

  # ip_unprivileged_port_start stays at the default 1024: a rootless container
  # cannot publish :80 or :443. Front them with a reverse proxy on a high port,
  # or lower this deliberately. ping_group_range is opened so containers can
  # ping, which Debian disables by default.
  - path: /etc/sysctl.d/21-rootless.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ping_group_range = 0 2147483647

  # systemd-tmpfiles-setup runs after local-fs.target and before basic.target,
  # so this creates the data-root with the right owner before the user manager
  # (and therefore the rootless daemon) can start. Ordering a normal service
  # before a user@UID instance is not expressible; this is.
  - path: /etc/tmpfiles.d/60-appdata-docker.conf
    owner: root:root
    permissions: "0644"
    content: |
      d /mnt/appdata/docker 0700 admin admin -

  # Rootless Docker cannot load networking modules as admin. modules-load.d
  # handles later boots; the finalizer loads it explicitly on the build boot
  # because write-files runs after systemd-modules-load.service.
  - path: /etc/modules-load.d/60-rootless-docker.conf
    owner: root:root
    permissions: "0644"
    content: |
      nf_tables
#% endif

  - path: /usr/local/sbin/appdata-verify
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -Eeuo pipefail

      expected_link=/dev/disk/by-id/wwn-@@APPDATA_WWN@@
      udevadm settle
      [ -L "$expected_link" ] || {
        echo "APPDATA disk is missing: expected $expected_link" >&2
        exit 1
      }

      expected_dev="$(readlink -f -- "$expected_link")"
      [ -b "$expected_dev" ] || {
        echo "APPDATA target is not a block device: $expected_dev" >&2
        exit 1
      }

      expected_serial="$(lsblk -dn -o SERIAL -- "$expected_dev" | xargs)"
      [ "$expected_serial" = "@@APPDATA_SERIAL@@" ] || {
        echo "APPDATA serial mismatch on $expected_dev: $expected_serial" >&2
        exit 1
      }

      mountpoint -q /mnt/appdata || {
        echo "APPDATA is not mounted at /mnt/appdata" >&2
        exit 1
      }
      app_mount_count="$(findmnt -rn --mountpoint /mnt/appdata -o TARGET | wc -l)"
      [ "$app_mount_count" -eq 1 ] || {
        echo "APPDATA must be mounted exactly once; found $app_mount_count mounts" >&2
        findmnt -rn --mountpoint /mnt/appdata -o TARGET,SOURCE,FSTYPE,OPTIONS >&2 || true
        exit 1
      }

      mounted_source="$(findmnt -rn --mountpoint /mnt/appdata -o SOURCE)"
      mounted_dev="$(readlink -f -- "$mounted_source")"
      [ -b "$mounted_dev" ] || {
        echo "APPDATA mount source is not a block device: $mounted_source" >&2
        exit 1
      }

      expected_id="$(lsblk -dn -o MAJ:MIN -- "$expected_dev" | xargs)"
      mounted_id="$(lsblk -dn -o MAJ:MIN -- "$mounted_dev" | xargs)"
      if [ -z "$expected_id" ] || [ "$mounted_id" != "$expected_id" ]; then
        echo "APPDATA source mismatch: expected $expected_dev, mounted $mounted_dev" >&2
        exit 1
      fi

      [ "$(findmnt -rn --mountpoint /mnt/appdata -o FSTYPE)" = ext4 ] || {
        echo "APPDATA mount is not ext4" >&2
        exit 1
      }
      [ "$(blkid -s LABEL -o value "$mounted_dev")" = APPDATA ] || {
        echo "APPDATA filesystem label is not APPDATA" >&2
        exit 1
      }

#% if docker
      # tmpfiles.d owns creation; this only proves it happened on the real disk.
      [ -d /mnt/appdata/docker ] || {
        echo "Docker data-root is missing: /mnt/appdata/docker" >&2
        exit 1
      }
      [ "$(stat -c '%U' /mnt/appdata/docker)" = admin ] || {
        echo "Docker data-root is not owned by admin: $(stat -c '%U' /mnt/appdata/docker)" >&2
        exit 1
      }
      # dockerd sets this directory to 0710 when it starts, so an exact-mode
      # assertion passes on the build boot and fails on every boot after it.
      # Assert the property that matters instead: nobody else can write here.
      docker_root_mode="$(stat -c '%a' /mnt/appdata/docker)"
      [ "$(( 0"$docker_root_mode" & 0022 ))" -eq 0 ] || {
        echo "Docker data-root is group- or world-writable: $docker_root_mode" >&2
        exit 1
      }
#% endif

  - path: /etc/systemd/system/appdata-verify.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Verify APPDATA disk identity
      RequiresMountsFor=/mnt/appdata
      After=systemd-tmpfiles-setup.service
      Before=systemd-user-sessions.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/appdata-verify
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

#% if docker
  # Deferred to the final stage: the admin user does not exist yet when the
  # write-files module runs, so owner: admin:admin would fail.
  - path: /home/admin/.config/docker/daemon.json
    owner: admin:admin
    permissions: "0600"
    defer: true
    content: |
      {
        "data-root": "/mnt/appdata/docker",
        "log-driver": "journald",
        "log-opts": {
          "tag": "docker/{{.Name}}",
          "labels": "com.docker.compose.project,com.docker.compose.service"
        },
        "max-concurrent-downloads": 24,
        "max-concurrent-uploads": 8
      }

  # Refuse to start rather than silently populating the root disk if APPDATA is
  # missing. This is what makes the boot ordering non-load-bearing.
  - path: /home/admin/.config/systemd/user/docker.service.d/10-require-appdata.conf
    owner: admin:admin
    permissions: "0644"
    defer: true
    content: |
      [Service]
      ExecStartPre=/usr/bin/test -O /mnt/appdata/docker
#% endif

  - path: /usr/local/sbin/cloud-init-report
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -u
      umask 077

      status="${1:-unknown}"
      exit_code="${2:-unknown}"
      failure_line="${3:-unknown}"
      log_dir=/home/admin/logs

      install -d -m 0700 -o admin -g admin "$log_dir"
      {
        printf 'bootstrap_status=%s\n' "$status"
        printf 'exit_code=%s\n' "$exit_code"
        printf 'failure_line=%s\n' "$failure_line"
        printf 'captured_at=%s\n' "$(date --iso-8601=seconds)"
        echo "### /etc/kasa-image-release"
        cat /etc/kasa-image-release || true
        echo "### cloud-init status"
        cloud-init status --long || true
        echo "### cloud-init journal"
        journalctl -b -o short-iso --no-pager \
          -u cloud-init-local.service \
          -u cloud-init-network.service \
          -u cloud-config.service \
          -u cloud-final.service || true
        echo "### /var/log/cloud-init.log"
        [ ! -s /var/log/cloud-init.log ] || cat /var/log/cloud-init.log
        echo "### /var/log/cloud-init-output.log"
        [ ! -s /var/log/cloud-init-output.log ] || cat /var/log/cloud-init-output.log
      } > "$log_dir/cloud-init-full.log"

      {
        journalctl -b -o short-iso --no-pager -p warning \
          -u cloud-init-local.service \
          -u cloud-init-network.service \
          -u cloud-config.service \
          -u cloud-final.service || true
        [ ! -s /var/log/cloud-init.log ] || \
          grep -Ei "warning|error|critical|traceback|exception|failed" \
            /var/log/cloud-init.log || true
        [ ! -s /var/log/cloud-init-output.log ] || \
          grep -Ei "warning|error|critical|traceback|exception|failed" \
            /var/log/cloud-init-output.log || true
      } > "$log_dir/cloud-init-errors.log"

      dpkg-query --show --showformat='${binary:Package}\t${Version}\n' \
        2>/dev/null | sort > "$log_dir/packages.tsv" || true
#% if docker
      admin_uid="$(id -u admin 2>/dev/null || echo 0)"
      runuser -u admin -- env \
        XDG_RUNTIME_DIR="/run/user/${admin_uid}" \
        DOCKER_HOST="unix:///run/user/${admin_uid}/docker.sock" \
        docker version > "$log_dir/docker-version.txt" 2>&1 || \
        docker --version > "$log_dir/docker-version.txt" 2>&1 || true
#% endif

      chown -R admin:admin "$log_dir"
      find "$log_dir" -maxdepth 1 -type f -exec chmod 0600 {} +

  # cloud-init deletes status.json at the start of every boot, so `cloud-init status`
  # describes only the boot it runs on. A first boot that was interrupted, or that
  # failed and was then rebooted, leaves nothing behind that says so, and the next boot
  # reports `done`. This keeps each earlier boot's final status so the verifier can
  # judge the whole bootstrap rather than whichever boot it happens to run on.
  - path: /usr/local/sbin/cloud-init-bootstrap-history
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/python3
      """What cloud-init recorded about every boot of this instance.

        archive               keep the previous boot's status, before init-local deletes it
        verify                every earlier boot is clean, or superseded by a rerun
        eligible              the failure is one cloud-init-rerun-bootstrap can repair;
                              prints this boot's number
        approved-deprecation  print the one recoverable error the verifier accepts
      """

      import json
      import os
      import sys
      from pathlib import Path

      INSTANCE = Path("/var/lib/cloud/instance")
      STATUS = Path("/var/lib/cloud/data/status.json")
      ARCHIVE = INSTANCE / "kasa-boot-status"
      RERUN_RECORD = INSTANCE / "kasa-bootstrap-rerun"
      SUCCESS_MARKER = INSTANCE / "boot-success"
      # Written by cloud-init's final_message at the very end of every boot's final
      # stage, and deleted by the next boot's init-local. Still present when archive
      # runs means the boot got that far.
      BOOT_FINISHED = INSTANCE / "boot-finished"
      STAGES = ("init-local", "init", "modules-config", "modules-final")
      # cloud-init-rerun-bootstrap re-executes this stage and no other, so a failure in
      # any earlier stage is not something a rerun repairs.
      RERUN_STAGE = "modules-final"
      APPROVED_DEPRECATION = (
          "'user' of type string is deprecated in 22.2 and scheduled to be removed "
          "in 27.2. Use 'users' list instead."
      )


      def load(path):
          try:
              return json.loads(path.read_text(encoding="utf-8"))
          except (OSError, ValueError):
              return None


      def recoverable_approved(recoverable):
          if not recoverable:
              return True
          if not isinstance(recoverable, dict) or set(recoverable) != {"DEPRECATED"}:
              return False
          messages = recoverable["DEPRECATED"]
          return isinstance(messages, list) and all(
              message == APPROVED_DEPRECATION for message in messages
          )


      def stage_problems(status, reached_the_end=True):
          """Map every stage that did not finish cleanly to the reason."""
          v1 = status.get("v1") if isinstance(status, dict) else None
          if not isinstance(v1, dict):
              return {stage: "status is unreadable" for stage in STAGES}
          problems = {}
          for stage in STAGES:
              entry = v1.get(stage)
              if not isinstance(entry, dict) or not entry.get("start"):
                  problems[stage] = "never started"
              elif not entry.get("finished"):
                  problems[stage] = "started and never finished"
              elif entry.get("errors"):
                  problems[stage] = "; ".join(str(error) for error in entry["errors"])
              elif not recoverable_approved(entry.get("recoverable_errors")):
                  problems[stage] = "recoverable errors besides the approved deprecation"
          # A clean shutdown's SIGTERM is not always an error in status.json: cloud-init
          # 26.1 (Ubuntu 24.04) exits 0 on it, so the interrupted stage reads as finished
          # with no errors. The stages after it never start, which is caught above, so a
          # boot that never reached final_message with nothing else wrong was cut off
          # inside modules-final.
          if not reached_the_end and not problems:
              problems[RERUN_STAGE] = "cut off before cloud-init finished the boot"
          return problems


      def describe(number, problems):
          reasons = "; ".join(f"{stage} {reason}" for stage, reason in problems.items())
          return f"boot {number}: {reasons}"


      def archived_boots():
          """Earlier boots of this instance as (number, problems), oldest first."""
          if not ARCHIVE.is_dir():
              return []
          boots = [
              (
                  int(path.stem),
                  stage_problems(
                      load(path),
                      not (ARCHIVE / f"{path.stem}.unfinished").exists(),
                  ),
              )
              for path in ARCHIVE.glob("*.json")
              if path.stem.isdigit()
          ]
          return sorted(boots, key=lambda boot: boot[0])


      def superseded_through():
          try:
              lines = RERUN_RECORD.read_text(encoding="utf-8").splitlines()
          except OSError:
              return 0
          for line in lines:
              key, _, value = line.partition("=")
              if key == "superseded_through" and value.isdigit():
                  return int(value)
          return 0


      def archive():
          # The bytes, not a parse: a truncated status stays truncated here and is
          # judged unreadable by verify, rather than dropped.
          if SUCCESS_MARKER.exists() or not STATUS.is_file() or not INSTANCE.is_dir():
              return 0
          ARCHIVE.mkdir(mode=0o700, exist_ok=True)
          boots = archived_boots()
          number = boots[-1][0] + 1 if boots else 1
          # The marker first, so a record can never exist without it.
          if not BOOT_FINISHED.exists():
              (ARCHIVE / f"{number}.unfinished").touch()
          partial = ARCHIVE / f".{number}.json.partial"
          partial.write_bytes(STATUS.read_bytes())
          os.replace(partial, ARCHIVE / f"{number}.json")
          return 0


      def verify():
          floor = superseded_through()
          rerunnable, unrecoverable = [], []
          for number, problems in archived_boots():
              if not problems:
                  continue
              if set(problems) == {RERUN_STAGE}:
                  if number > floor:
                      rerunnable.append(describe(number, problems))
              else:
                  unrecoverable.append(describe(number, problems))
          for line in unrecoverable + rerunnable:
              print(f"An earlier boot did not complete: {line}", file=sys.stderr)
          if unrecoverable:
              print(
                  "A stage before modules-final failed, which a rerun does not repeat. "
                  "Rebuild the guest.",
                  file=sys.stderr,
              )
          elif rerunnable:
              print(
                  "No rerun of the bootstrap covers it. Run cloud-init-rerun-bootstrap "
                  "and reboot.",
                  file=sys.stderr,
              )
          return 1 if unrecoverable or rerunnable else 0


      def eligible():
          current = load(STATUS)
          if isinstance(current, dict) and isinstance(current.get("v1"), dict):
              if current["v1"].get("stage"):
                  print("cloud-init is still running on this boot", file=sys.stderr)
                  return 1
          boots = archived_boots()
          number = boots[-1][0] + 1 if boots else 1
          refused = [
              describe(boot, problems)
              for boot, problems in boots + [(number, stage_problems(current))]
              if set(problems) - {RERUN_STAGE}
          ]
          for line in refused:
              print(f"Not repairable by a rerun: {line}", file=sys.stderr)
          if refused:
              print(
                  "A rerun repeats only modules-final. Rebuild the guest.",
                  file=sys.stderr,
              )
              return 1
          print(number)
          return 0


      COMMANDS = {
          "archive": archive,
          "verify": verify,
          "eligible": eligible,
          "approved-deprecation": lambda: print(APPROVED_DEPRECATION) or 0,
      }

      if __name__ == "__main__":
          os.umask(0o077)
          if len(sys.argv) != 2 or sys.argv[1] not in COMMANDS:
              print(__doc__, file=sys.stderr)
              sys.exit(2)
          sys.exit(COMMANDS[sys.argv[1]]())

  # ExecStartPre runs before this unit's shim tells cloud-init's main process to
  # start init-local, which is where status.json is deleted. That holds in both
  # single-process and per-stage cloud-init. A drop-in rather than an enabled unit:
  # write_files puts it in place on the first boot even when that boot never reaches
  # the finalizer, and the boot after an interrupted one is the one that needs it.
  # `-` because a failed archive must not stop cloud-init from running at all.
  - path: /etc/systemd/system/cloud-init-local.service.d/10-kasa-bootstrap-history.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      ExecStartPre=-/usr/local/sbin/cloud-init-bootstrap-history archive

  - path: /usr/local/sbin/cloud-init-rerun-bootstrap
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      # Rerun this instance's bootstrap on the next boot, after a first boot that was
      # interrupted or failed in cloud-init's final stage.
      #
      # cloud-init takes a per-instance module's semaphore before the module runs and
      # never releases it, not when the module fails and not when the boot is cut off.
      # So neither a reboot nor `cloud-init modules --mode final` reruns the package
      # stage or the finalizer. `cloud-init single` does, but it never writes
      # cloud-init's status, which goes on reporting the original failure. This clears
      # the final stage's semaphores so the next boot runs that stage again under
      # cloud-init's own status, and cloud-init-post-verify judges the result.
      #
      # It does not reboot. It never runs `cloud-init clean`, which would regenerate the
      # SSH host keys and discard this instance's records, and never writes boot-success.
      set -Eeuo pipefail
      umask 077

      instance_dir=/var/lib/cloud/instance
      history=/usr/local/sbin/cloud-init-bootstrap-history

      if [ "$(id -u)" -ne 0 ]; then
        echo "cloud-init-rerun-bootstrap must run as root" >&2
        exit 1
      fi
      if [ -e "$instance_dir/boot-success" ]; then
        echo "This instance's bootstrap is already verified; there is nothing to rerun" >&2
        exit 1
      fi
      boot_number="$("$history" eligible)"

      final_semaphores="$(
        /usr/bin/python3 -c '
      from cloudinit import util

      config = util.read_conf_with_confd("/etc/cloud/cloud.cfg")
      for module in config.get("cloud_final_modules") or []:
          if isinstance(module, dict):
              module = module.get("name")
          elif isinstance(module, list):
              module = module[0] if module else None
          if isinstance(module, str) and module.strip():
              print("config_" + module.strip().replace("-", "_"))
      '
      )"
      if ! grep -Fxq config_scripts_user <<<"$final_semaphores"; then
        echo "scripts_user is not in cloud_final_modules; a rerun would skip the finalizer" >&2
        exit 1
      fi
      # The package stage's `apt-get update` runs under a per-instance semaphore of its
      # own, not the module's. Left in place, the rerun installs from whatever package
      # lists the interrupted boot left behind. On an Ubuntu 24.04 clone shut down during
      # that update on 2026-09-24, apt then did not know qemu-guest-agent or fail2ban.
      final_semaphores+=$'\nupdate_sources'

      # Everything this boot knows, before anything changes it. The finalizer's own
      # report in /home/admin/logs is rewritten by the next failure, and a -syslog
      # profile's journal does not survive the reboot this is preparing for.
      evidence="$instance_dir/kasa-recovery/$(date -u +%Y%m%dT%H%M%SZ)"
      install -d -m 0700 "$evidence"
      cp -p /var/lib/cloud/data/status.json "$evidence/"
      [ ! -f /var/lib/cloud/data/result.json ] || cp -p /var/lib/cloud/data/result.json "$evidence/"
      [ ! -d /home/admin/logs ] || cp -pR /home/admin/logs "$evidence/admin-logs"
      ls -l --time-style=full-iso "$instance_dir/sem" > "$evidence/semaphores.txt"
      cat /proc/sys/kernel/random/boot_id > "$evidence/boot_id"
      dpkg_audit_exit=0
      dpkg --audit > "$evidence/dpkg-audit.txt" 2>&1 || dpkg_audit_exit="$?"
      journalctl -b -o short-iso --no-pager \
        -u cloud-init-main.service \
        -u cloud-init-local.service \
        -u cloud-init-network.service \
        -u cloud-config.service \
        -u cloud-final.service \
        -u cloud-init-post-verify.service \
        > "$evidence/journal.txt" 2>&1 || true

      # dpkg exits 2 when it cannot read its own database, as opposed to 1 for packages
      # left half-configured. A hard power-off can do that: on an Ubuntu 24.04 clone
      # stopped 60 s into its first boot on 2026-09-24, ext4 had committed the sizes of
      # every file under /var/lib/dpkg/updates but none of their contents, so all of
      # them read back as NULs. That is a damaged package database, not an unfinished
      # run, and nothing here can say which packages it describes. Refuse before
      # anything changes.
      if [ "$dpkg_audit_exit" -ge 2 ]; then
        cat "$evidence/dpkg-audit.txt" >&2
        echo "dpkg cannot read its database, so a rerun cannot be trusted. Rebuild the guest. Evidence kept in $evidence." >&2
        exit 1
      fi

      # A boot cut off inside dpkg leaves packages half-configured, and apt then refuses
      # to start, including in the package stage this is about to rerun. Finishing the
      # interrupted run is dpkg's own recovery; on a clean system it does nothing.
      if ! DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold; then
        echo "dpkg --configure -a failed, so a rerun would fail the same way. Rebuild the guest. Evidence kept in $evidence." >&2
        exit 1
      fi

      # The record first: if clearing stops partway, the next verifier still knows a
      # rerun was requested and which boots it covers.
      {
        printf 'superseded_through=%s\n' "$boot_number"
        printf 'requested_at=%s\n' "$(date --iso-8601=seconds)"
        printf 'evidence=%s\n' "$evidence"
      } > "$instance_dir/kasa-bootstrap-rerun"
      while IFS= read -r semaphore; do
        rm -f -- "$instance_dir/sem/$semaphore"
      done <<<"$final_semaphores"
      rm -f "$instance_dir/bootstrap-precheck-ok"

      logger -t kasa-bootstrap -p daemon.notice \
        "KASA bootstrap rerun requested through boot ${boot_number}; evidence in ${evidence}" \
        || true
      echo "Evidence kept in $evidence."
      echo "Reboot to rerun the final stage: systemctl reboot"

  - path: /usr/local/sbin/cloud-init-post-verify
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -Eeuo pipefail

      success_marker=/var/lib/cloud/instance/boot-success
      precheck_marker=/var/lib/cloud/instance/bootstrap-precheck-ok
      history=/usr/local/sbin/cloud-init-bootstrap-history
      rm -f "$success_marker"

      on_error() {
        local exit_code="$1"
        local failure_line="$2"
        trap - ERR
        rm -f "$success_marker"
        # See the matching comment in cloud-init-finalize: a failed bootstrap is otherwise
        # silent, and on a -syslog profile the journal does not survive a reboot.
        logger -t kasa-bootstrap -p daemon.err \
          "KASA bootstrap verification FAILED at line ${failure_line} (exit ${exit_code}); full log at /home/admin/logs/cloud-init-full.log" \
          || true
        /usr/local/sbin/cloud-init-report failure "$exit_code" "$failure_line" || true
        exit "$exit_code"
      }
      trap 'on_error "$?" "$LINENO"' ERR

      if [ ! -f "$precheck_marker" ]; then
        echo "cloud-init bootstrap prechecks did not complete" >&2
        on_error 1 "$LINENO"
      fi
      if [ ! -f /var/lib/cloud/instance/boot-finished ]; then
        echo "cloud-init boot-finished marker is missing" >&2
        on_error 1 "$LINENO"
      fi

      # The status read below describes this boot and no other, so it vouches for the
      # bootstrap only on the boot the finalizer ran on. After a reboot the finalizer
      # does not run again and the status resets to `done`. A verifier restarted then
      # would pass on a status that never saw the bootstrap.
      if ! grep -Fxq "boot_id=$(cat /proc/sys/kernel/random/boot_id)" "$precheck_marker"; then
        echo "Bootstrap prechecks passed on an earlier boot, which this boot's cloud-init status does not cover. Run cloud-init-rerun-bootstrap and reboot." >&2
        on_error 1 "$LINENO"
      fi
      if ! "$history" verify; then
        on_error 1 "$LINENO"
      fi
      approved_deprecation="$("$history" approved-deprecation)"

      cloud_status_exit=0
      if cloud_status_output="$(cloud-init status --format json 2>&1)"; then
        :
      else
        cloud_status_exit="$?"
      fi
      printf '%s\n' "$cloud_status_output"
      case "$cloud_status_exit" in
        0)
          ;;
        2)
          if ! /usr/bin/python3 -c '
      import json
      import sys

      expected = sys.argv[1]
      try:
          status = json.load(sys.stdin)
      except (json.JSONDecodeError, UnicodeDecodeError):
          raise SystemExit(1)

      if not isinstance(status, dict):
          raise SystemExit(1)
      recoverable = status.get("recoverable_errors")
      deprecated = (
          recoverable.get("DEPRECATED")
          if isinstance(recoverable, dict)
          else None
      )
      approved = (
          status.get("status") == "done"
          and status.get("extended_status") == "degraded done"
          and status.get("errors") == []
          and isinstance(recoverable, dict)
          and set(recoverable) == {"DEPRECATED"}
          and isinstance(deprecated, list)
          and bool(deprecated)
          and all(message == expected for message in deprecated)
      )
      raise SystemExit(0 if approved else 1)
      ' "$approved_deprecation" <<<"$cloud_status_output"; then
            echo "cloud-init degraded for an unapproved reason" >&2
            on_error "$cloud_status_exit" "$LINENO"
          fi
          ;;
        *)
          echo "cloud-init completed with status $cloud_status_exit" >&2
          on_error "$cloud_status_exit" "$LINENO"
          ;;
      esac

      touch "$success_marker"
      trap - ERR

  # Started by cloud-init-finalize and by nothing else, which is why the unit has no
  # [Install] section. Its verdict leans on this boot's cloud-init status, and that
  # covers the bootstrap only on the boot the finalizer ran on. So a reboot never
  # starts it: cloud-init skips the finalizer on later boots, and a status reset to
  # `done` must not be mistaken for a bootstrap that passed. The verifier refuses to
  # run on any other boot even when started by hand. Recovery is
  # cloud-init-rerun-bootstrap followed by a reboot, which runs the finalizer, and
  # therefore this, on a boot whose status covers it.
  - path: /etc/systemd/system/cloud-init-post-verify.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Validate completed cloud-init bootstrap
      Wants=cloud-init.target
      After=cloud-init.target
      ConditionPathExists=/var/lib/cloud/instance/bootstrap-precheck-ok
      ConditionPathExists=!/var/lib/cloud/instance/boot-success

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/cloud-init-post-verify
      RemainAfterExit=yes

  - path: /usr/local/sbin/cloud-init-finalize
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -Eeuo pipefail

      success_marker=/var/lib/cloud/instance/boot-success
      precheck_marker=/var/lib/cloud/instance/bootstrap-precheck-ok
      rm -f "$success_marker" "$precheck_marker"

      on_error() {
        local exit_code="$1"
        local failure_line="$2"
        trap - ERR
        rm -f "$precheck_marker"
        # To the collector, not only to disk. A failed bootstrap is otherwise silent: a
        # failing runcmd is recorded by cloud-init as a WARNING, the semaphore is written
        # anyway, and `cloud-init status` goes on reporting `done` with `errors: []`. On a
        # -syslog profile the journal is volatile, so the local copy does not survive a
        # reboot either -- and the report below writes somewhere nobody looks until they
        # already suspect something. This line is what makes the failure findable.
        logger -t kasa-bootstrap -p daemon.err \
          "KASA bootstrap FAILED at line ${failure_line} (exit ${exit_code}); full log at /home/admin/logs/cloud-init-full.log" \
          || true
        /usr/local/sbin/cloud-init-report failure "$exit_code" "$failure_line" || true
        exit "$exit_code"
      }
      trap 'on_error "$?" "$LINENO"' ERR

      # Package gate, before anything depends on a package. cloud-init takes a
      # per-instance module's semaphore before the module runs and keeps it, so a boot
      # cut off inside the package stage leaves that stage marked as done. The next
      # boot skips it and runs this script against a half-installed system, where the
      # first missing package fails some unrelated-looking line further down. Measured
      # on github-runner01 (VM 410) on 2026-09-24: an ACPI shutdown 73 s into the first
      # boot, mid-upgrade, surfaced on the next boot as "Unit dev-zram0.swap not
      # found". The list is read from the configuration cloud-init was given.
      mapfile -t baseline_packages < <(
        /usr/bin/python3 -c '
      import yaml

      with open("/var/lib/cloud/instance/vendor-data.txt", encoding="utf-8") as stream:
          print("\n".join(yaml.safe_load(stream)["packages"]))
      '
      )
      [ "${#baseline_packages[@]}" -gt 0 ] || {
        echo "Could not read the package list from cloud-init vendor-data" >&2
        on_error 1 "$LINENO"
      }
      missing_packages=()
      for package in "${baseline_packages[@]}"; do
        package_state="$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null || true)"
        [ "$package_state" = installed ] || missing_packages+=("$package")
      done
      dpkg_audit="$(dpkg --audit 2>&1 || true)"
      if [ "${#missing_packages[@]}" -gt 0 ] || [ -n "$dpkg_audit" ]; then
        echo "The package stage did not complete on this instance." >&2
        [ "${#missing_packages[@]}" -eq 0 ] || \
          echo "Not installed: ${missing_packages[*]}" >&2
        [ -z "$dpkg_audit" ] || printf 'dpkg --audit:\n%s\n' "$dpkg_audit" >&2
        echo "Run cloud-init-rerun-bootstrap and reboot." >&2
        on_error 1 "$LINENO"
      fi

      # Proxmox-generated user-data owns the hostname; validate the guest state
      # it produced instead of the datasource metadata, which NoCloud omits.
      static_hostname="$(hostnamectl --static 2>/dev/null || true)"
      runtime_hostname="$(hostname 2>/dev/null || true)"
      file_hostname="$(tr -d '\n' </etc/hostname 2>/dev/null || true)"

      case "$static_hostname" in
        ""|localhost|localhost.localdomain|*.)
          echo "Invalid static hostname: ${static_hostname:-missing}" >&2
          on_error 1 "$LINENO"
          ;;
      esac

      if [ "$runtime_hostname" != "$static_hostname" ]; then
        echo \
          "Runtime hostname mismatch: static=$static_hostname runtime=$runtime_hostname" \
          >&2
        on_error 1 "$LINENO"
      fi

      if [ "$file_hostname" != "$static_hostname" ]; then
        echo \
          "/etc/hostname mismatch: static=$static_hostname file=${file_hostname:-missing}" \
          >&2
        on_error 1 "$LINENO"
      fi

      # Proxmox ciuser creates admin from the image default user, so pin the
      # account policy here rather than trusting the image defaults to hold.
      if ! getent passwd admin >/dev/null; then
        echo "admin user was not created" >&2
        on_error 1 "$LINENO"
      fi

      usermod \
        --comment Admin \
        --shell /bin/bash \
        --append \
        --groups adm,sudo \
        admin
      passwd --lock admin >/dev/null

      install -d -m 0750 /etc/sudoers.d
      printf '%s\n' \
        'admin ALL=(ALL) NOPASSWD:ALL' \
        > /etc/sudoers.d/90-admin
      chmod 0440 /etc/sudoers.d/90-admin
      visudo -cf /etc/sudoers.d/90-admin

      [ "$(getent passwd admin | cut -d: -f7)" = /bin/bash ] || {
        echo "admin shell is not /bin/bash" >&2
        on_error 1 "$LINENO"
      }
      [ "$(passwd -S admin | awk '{print $2}')" = L ] || {
        echo "admin password is not locked" >&2
        on_error 1 "$LINENO"
      }
      for admin_group in adm sudo; do
        id -nG admin | tr ' ' '\n' | grep -Fxq "$admin_group" || {
          echo "admin is not a member of $admin_group" >&2
          on_error 1 "$LINENO"
        }
      done

      if [ ! -d /home/admin ]; then
        echo "admin home directory is missing" >&2
        on_error 1 "$LINENO"
      fi
      install -d -m 0700 -o admin -g admin /home/admin/.ssh
      install -d -m 0700 -o admin -g admin /home/admin/apps
      # Also fixes the parents of the deferred admin-owned files, which the
      # write-files module creates as root.
      chown -R admin:admin /home/admin
      chmod 0700 /home/admin

      # Reachability gate. A host needs at least one way to authenticate an operator,
      # or this boot has produced a VM nobody can enter -- so failing here is the point,
      # not a nuisance. Either anchor alone is sufficient. Both is the normal case and
      # the safest one: the injected key is break-glass for a certificate outage.
      install -d -m 0755 /run/sshd

      # Config test first, so a syntax error is reported as a syntax error. The effective
      # check below reads the same configuration, and running it first would report a
      # broken sshd_config as a missing CA trust.
      /usr/sbin/sshd -t

      ssh_anchor=""

      if [ -s /home/admin/.ssh/authorized_keys ]; then
        ssh-keygen -l -f /home/admin/.ssh/authorized_keys >/dev/null
        ssh_anchor="authorized_keys"
      fi
#% if ssh_user_ca
      # ssh-keygen -l is not redundant with sshd -t. sshd -t exits 0 against a
      # TrustedUserCAKeys naming a file that is missing or truncated -- it never reads
      # the key at config-test time -- so this is the only check that catches a
      # malformed CA key. sshd -T is then the only thing that proves the drop-in was
      # included rather than written and silently ignored.
      ssh-keygen -l -f /etc/ssh/kasa_user_ca.pub >/dev/null

      # sshd -T is retried, and its failure is reported as its own failure.
      #
      # It loads the entire effective configuration, host keys included, so on a first
      # boot it can exit non-zero for reasons that have nothing to do with this drop-in --
      # a host key cloud-init has not finished generating being the likely one. When it
      # does, it writes nothing to stdout.
      #
      # The previous version discarded both the exit status and stderr, so any such
      # failure reached the operator as "the SSH user CA was installed but sshd is not
      # serving it": a different problem, with a different fix, and one that sends you
      # looking at a drop-in that is perfectly correct. Measured on librechat (VM 211) on
      # 2026-09-02, where this aborted the bootstrap 1.07 seconds in and left the guest
      # without its rootless Docker setup -- and, because a failed runcmd does not stop
      # cloud-init reporting `done`, looking healthy.
      sshd_probe_error=/run/kasa-sshd-config-test.err
      sshd_effective=""
      sshd_ok=0
      for _ in $(seq 1 30); do
        if sshd_effective="$(/usr/sbin/sshd -T 2>"$sshd_probe_error")"; then
          sshd_ok=1
          break
        fi
        sleep 1
      done
      if [ "$sshd_ok" -ne 1 ]; then
        echo "sshd -T did not succeed within 30s:" >&2
        cat "$sshd_probe_error" >&2 || true
        rm -f "$sshd_probe_error"
        on_error 1 "$LINENO"
      fi
      rm -f "$sshd_probe_error"

      if grep -qi '^trustedusercakeys /etc/ssh/kasa_user_ca\.pub$' \
        <<<"$sshd_effective"; then
        ssh_anchor="${ssh_anchor:+$ssh_anchor and }SSH user CA"
      else
        echo "The SSH user CA was installed but sshd is not serving it" >&2
        on_error 1 "$LINENO"
      fi
#% endif

      if [ -z "$ssh_anchor" ]; then
        echo \
          "No SSH key was supplied through Proxmox cloud-init data and no SSH user CA is trusted" \
          >&2
        on_error 1 "$LINENO"
      fi
      echo "SSH access anchored by: $ssh_anchor"

      systemctl daemon-reload
      /usr/lib/systemd/systemd-sysctl
      for rp_filter_key in \
        net.ipv4.conf.all.rp_filter \
        net.ipv4.conf.default.rp_filter; do
        rp_filter_value="$(/usr/sbin/sysctl -n "$rp_filter_key")"
        [ "$rp_filter_value" = 1 ] || {
          echo "$rp_filter_key is not strict after systemd-sysctl: $rp_filter_value" >&2
          on_error 1 "$LINENO"
        }
      done
      systemctl start dev-zram0.swap
      systemctl is-active --quiet dev-zram0.swap

      systemctl enable --now qemu-guest-agent.service
      systemctl is-active --quiet qemu-guest-agent.service

      systemctl enable --now unattended-upgrades.service
      systemctl is-active --quiet unattended-upgrades.service

      fail2ban-client -t
      systemctl enable --now fail2ban.service
      systemctl is-active --quiet fail2ban.service

      systemctl reload ssh.service
      systemctl is-active --quiet ssh.service
      systemctl enable --now fstrim.timer

#% if docker
      # write-files runs after systemd-tmpfiles-setup during the image build,
      # so create the Docker data-root explicitly before verifying APPDATA.
      systemd-tmpfiles --create /etc/tmpfiles.d/60-appdata-docker.conf
#% endif
      systemctl enable appdata-verify.service
      systemctl start appdata-verify.service
      systemctl is-active --quiet appdata-verify.service

#% if docker
      # --- Rootless Docker ---
      # The rootful daemon was masked in bootcmd so it never started. Make that
      # state explicit and permanent, and stop the system containerd: a rootless
      # daemon runs its own inside the user namespace.
      systemctl disable --now containerd.service
      systemctl mask docker.service docker.socket
      for masked_unit in docker.service docker.socket; do
        [ "$(systemctl is-enabled "$masked_unit" 2>/dev/null || true)" = masked ] || {
          echo "$masked_unit is not masked" >&2
          on_error 1 "$LINENO"
        }
      done

      # Subordinate ID ranges. useradd allocates these on Debian, but the admin
      # account comes from the cloud image rather than from useradd here, so
      # assert rather than assume.
      admin_uid="$(id -u admin)"
      grep -q '^admin:' /etc/subuid || usermod --add-subuids 100000-165535 admin
      grep -q '^admin:' /etc/subgid || usermod --add-subgids 100000-165535 admin
      grep -q '^admin:' /etc/subuid || {
        echo "admin has no subordinate UID range" >&2
        on_error 1 "$LINENO"
      }
      grep -q '^admin:' /etc/subgid || {
        echo "admin has no subordinate GID range" >&2
        on_error 1 "$LINENO"
      }

      # Lingering starts the user manager at boot with no login session, which
      # is what lets the rootless daemon come up on a clone nobody logs into.
      loginctl enable-linger admin
      [ -f "/var/lib/systemd/linger/admin" ] || {
        echo "lingering was not enabled for admin" >&2
        on_error 1 "$LINENO"
      }
      systemctl start "user@${admin_uid}.service"
      for _ in $(seq 1 30); do
        if systemctl is-active --quiet "user@${admin_uid}.service" && \
          [ -S "/run/user/${admin_uid}/bus" ]; then
          break
        fi
        sleep 1
      done
      systemctl is-active --quiet "user@${admin_uid}.service" || {
        echo "user manager for admin did not start" >&2
        on_error 1 "$LINENO"
      }
      [ -S "/run/user/${admin_uid}/bus" ] || {
        echo "user session bus is missing for admin" >&2
        on_error 1 "$LINENO"
      }

      # runuser rather than machinectl shell: machinectl does not propagate the
      # command's exit status, so a failed install would look like a success.
      # The two env vars are what a login session would otherwise provide.
      admin_env=(
        "XDG_RUNTIME_DIR=/run/user/${admin_uid}"
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${admin_uid}/bus"
        "DOCKER_HOST=unix:///run/user/${admin_uid}/docker.sock"
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      )
      /usr/sbin/modprobe nf_tables
      [ -d /sys/module/nf_tables ] || {
        echo "nf_tables kernel module did not load" >&2
        on_error 1 "$LINENO"
      }
      runuser -u admin -- env "${admin_env[@]}" \
        /usr/bin/dockerd-rootless-setuptool.sh install --force

      runuser -u admin -- env "${admin_env[@]}" \
        systemctl --user is-enabled --quiet docker.service || {
        echo "rootless docker.service is not enabled for admin" >&2
        on_error 1 "$LINENO"
      }
      runuser -u admin -- env "${admin_env[@]}" \
        systemctl --user is-active --quiet docker.service || {
        echo "rootless docker.service is not running for admin" >&2
        on_error 1 "$LINENO"
      }

      docker_root="$(
        runuser -u admin -- env "${admin_env[@]}" \
          timeout 60 docker info --format '{{.DockerRootDir}}'
      )"
      [ "$docker_root" = /mnt/appdata/docker ] || {
        echo "Docker data-root is $docker_root, expected /mnt/appdata/docker" >&2
        on_error 1 "$LINENO"
      }
      runuser -u admin -- env "${admin_env[@]}" \
        timeout 60 docker info --format '{{.SecurityOptions}}' | grep -q rootless || {
        echo "Docker is not running in rootless mode" >&2
        on_error 1 "$LINENO"
      }
      [ ! -d /var/lib/docker ] || {
        echo "/var/lib/docker exists; the rootful daemon ran" >&2
        on_error 1 "$LINENO"
      }
#% endif

#% if remote_syslog
      # --- Volatile journal + remote forwarding ---
      sed -i -E \
        's/^[[:space:]]*module\(load="imuxsock".*$/# disabled: using imjournal/; s/^[[:space:]]*module\(load="imklog".*$/# disabled: using imjournal/' \
        /etc/rsyslog.conf
      systemctl restart systemd-journald.service
#% endif
      /usr/sbin/rsyslogd -N1
      systemctl enable rsyslog.service
      systemctl restart rsyslog.service
      systemctl is-active --quiet rsyslog.service
#% if remote_syslog
      # Catch a broken StateFile path or a missing runtime directory here rather
      # than in production, where it would silently replay the journal.
      [ -e /run/rsyslog/imjournal.state ]
      logger -t cloud-init "remote syslog forwarding smoke test"

      # The collector is the only durable copy of the journal and syslog stream.
      # On the build boot an unreachable collector is a warning, because the
      # template must still be buildable without one; on a clone it is fatal,
      # because the VM would run blind.
      if ! timeout 10 openssl s_client \
        -connect "@@SYSLOG_TLS_ENDPOINT@@" \
        -servername "@@SYSLOG_TLS_NAME@@" \
        -CAfile /etc/ssl/certs/ca-certificates.crt \
        -verify_hostname "@@SYSLOG_TLS_NAME@@" -verify_return_error \
        </dev/null >/dev/null 2>&1; then
        if [ -f /etc/kasa-template-built ]; then
          echo "Syslog collector @@SYSLOG_SERVER@@:@@SYSLOG_PORT@@ failed TLS verification or is unreachable" >&2
          on_error 1 "$LINENO"
        fi
        echo \
          "WARNING: syslog collector @@SYSLOG_SERVER@@:@@SYSLOG_PORT@@ failed TLS verification or is unreachable" \
          >&2
      fi
#% endif
      # Present from the build boot onward, so clones can tell they are clones.
      touch /etc/kasa-template-built

      install -d -m 0700 "$(dirname "$precheck_marker")"
      # Names this boot, so the verifier can refuse to vouch for it from any other.
      printf 'boot_id=%s\n' "$(cat /proc/sys/kernel/random/boot_id)" > "$precheck_marker"
      systemctl start --no-block cloud-init-post-verify.service
      trap - ERR

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - cloud-guest-utils
  - fail2ban
  - nftables
  - openssh-server
  - qemu-guest-agent
  - rsyslog
#% if remote_syslog
  - rsyslog-gnutls
  - openssl
#% endif
  - sudo
  - systemd-zram-generator
  - unattended-upgrades
#% if docker
  - containerd.io
  - dbus-user-session
  - docker-buildx-plugin
  - docker-ce
  - docker-ce-cli
  - docker-ce-rootless-extras
  - docker-compose-plugin
  - iptables
  - slirp4netns
  - uidmap
#% endif

growpart:
  mode: auto
resize_rootfs: true

runcmd:
  - [/usr/local/sbin/cloud-init-finalize]
