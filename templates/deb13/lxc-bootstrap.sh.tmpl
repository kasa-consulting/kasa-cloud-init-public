#!/bin/bash
# KASA Debian @@RELEASE@@ LXC bootstrap
# Profile: @@PROFILE_NAME@@ — @@PROFILE_DESCRIPTION@@
#
# Generated by tools/build.py; edit templates/@@RELEASE@@/lxc-bootstrap.sh.tmpl,
# not this file.
#
# Run as root inside a started, unprivileged Debian 13 container that Proxmox
# created with an SSH public key and an APPDATA mount point.
#
# Re-running is safe and converges: configuration files are replaced atomically,
# user changes are conditional, and every service whose configuration is
# rewritten is restarted rather than merely started -- so a second run actually
# applies what changed. That means a re-run bounces the Docker daemon, and with
# it any running application containers.
#
# This bootstraps a container Proxmox already created. It is not an image build,
# and it deliberately carries none of the VM template's disk, cloud-init, guest
# agent, or zram machinery.

set -Eeuo pipefail

APPDATA_MOUNT='@@APPDATA_MOUNT@@'
TIMEZONE='@@TIMEZONE@@'
RELEASE='@@RELEASE@@'
PROFILE_NAME='@@PROFILE_NAME@@'
PROFILE_DESCRIPTION='@@PROFILE_DESCRIPTION@@'
# What this artifact was rendered for. The bootstrap is usable against any
# compatible container, so it cannot know which template the running one was
# actually created from -- hence "expected", not a claim about this container.
EXPECTED_LXC_TEMPLATE='@@LXC_TEMPLATE@@'
SOURCE_COMMIT='@@SOURCE_COMMIT@@'
SOURCE_TREE_DIRTY='@@SOURCE_TREE_DIRTY@@'
RENDERED_AT='@@RENDERED_AT@@'
DOCKER_ENABLED=no
LOGGING_MODE=local
#% if docker
DOCKER_ENABLED=yes
#% endif
#% if remote_syslog
LOGGING_MODE=remote
#% endif
#% if docker
# Off by default. Running it pulls and executes an image from a public registry
# and needs working DNS, so it must not be a precondition for provisioning a
# container. docs/lxc-runtime-test.md runs it deliberately. Override the
# reference with a digest (image@sha256:...) to pin exactly what gets executed.
RUN_DOCKER_SMOKE_TEST=no
SMOKE_IMAGE='busybox:stable'
#% endif

ROOT_KEYS=/root/.ssh/authorized_keys
ADMIN_KEYS=/home/admin/.ssh/authorized_keys

log()  { printf '[kasa] %s\n' "$*"; }
warn() { printf '[kasa] WARNING: %s\n' "$*" >&2; }
fail() { printf '[kasa] ERROR: %s\n' "$*" >&2; exit 1; }

on_error() {
  printf '[kasa] ERROR: bootstrap failed at line %s (exit %s)\n' "$2" "$1" >&2
#% if docker
  printf '%s\n' \
    '[kasa] If the Docker daemon failed to start, check that this container was' \
    '[kasa] created with features keyctl=1,nesting=1 and is still unprivileged.' >&2
#% endif
  exit "$1"
}
trap 'on_error "$?" "$LINENO"' ERR

# Replace a configuration file in one step, reading its content from stdin.
# Writing through a temporary file in the same directory means an interrupted
# run never leaves a half-written config behind, and a re-run replaces rather
# than appends, so no directive can accumulate a duplicate.
install_file() {
  local path=$1 mode=$2 dir tmp
  dir=${path%/*}
  mkdir -p -- "$dir"
  tmp=$(mktemp -- "$dir/.kasa-tmp.XXXXXXXX")
  cat >"$tmp"
  chmod -- "$mode" "$tmp"
  mv -f -- "$tmp" "$path"
}

usage() {
  printf '%s\n' \
    "Usage: $0 [options]" \
    '' \
    'Bootstraps this container to the KASA @@PROFILE_NAME@@ profile.'
#% if docker
  printf '%s\n' \
    '' \
    '  --docker-smoke-test   Also start a throwaway container to check runtime,' \
    '                        networking, the APPDATA bind mount and a memory' \
    '                        limit. Needs registry access and working DNS.' \
    '  --smoke-image REF     Image to use for that test, ideally pinned by' \
    "                        digest. Implies --docker-smoke-test. Default: $SMOKE_IMAGE."
#% endif
}

# At most one option, so the profiles without one do not carry a loop that can
# never take a second pass.
case ${1-} in
  '') ;;
#% if docker
  --docker-smoke-test) RUN_DOCKER_SMOKE_TEST=yes; shift ;;
  --smoke-image) RUN_DOCKER_SMOKE_TEST=yes; SMOKE_IMAGE=${2:?--smoke-image needs a reference}; shift 2 ;;
#% endif
  -h|--help) usage; exit 0 ;;
  *) fail "unknown argument: $1" ;;
esac
[ "$#" -eq 0 ] || fail "unexpected extra arguments: $*"

# --- Preflight ---------------------------------------------------------------
# Every check here runs before the first change, so a container that cannot be
# bootstrapped safely is left exactly as Proxmox created it.

log "Preflight checks"

[ "$(id -u)" -eq 0 ] || fail "run this bootstrap as root inside the container"

[ -r /etc/os-release ] || fail "/etc/os-release is missing; this is not a Debian system"
os_id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')
os_version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"')
[ "$os_id" = debian ] || fail "expected Debian, found '${os_id:-unknown}'"
[ "$os_version" = 13 ] || fail "expected Debian 13 (trixie), found '${os_version:-unknown}'"

if ! container_type=$(systemd-detect-virt --container); then
  fail "this bootstrap only runs inside a container; nothing was changed"
fi
[ "$container_type" = lxc ] || fail "expected an LXC container, found '$container_type'"

# In an unprivileged container, uid 0 inside maps to a non-zero, unprivileged
# uid on the Proxmox host. That mapping is the security boundary this profile
# depends on, so refuse to harden a container that does not have it rather than
# producing something that merely looks hardened.
[ -r /proc/self/uid_map ] || fail "/proc/self/uid_map is unreadable"
host_uid_for_root=$(awk '$1 == 0 { print $2; exit }' /proc/self/uid_map)
[ -n "$host_uid_for_root" ] || fail "could not read the root uid mapping"
[ "$host_uid_for_root" != 0 ] || fail \
  "this container is privileged: CT root maps to host root. Recreate it with --unprivileged 1"

# Either key source is enough. Root's key is what Proxmox seeds at create time;
# admin's key is what a previous run of this script installed. Requiring one of
# them up front means the SSH section can never lock everyone out.
have_key=no
if [ -s "$ROOT_KEYS" ] && ssh-keygen -l -f "$ROOT_KEYS" >/dev/null 2>&1; then
  have_key=yes
fi
if [ -s "$ADMIN_KEYS" ] && ssh-keygen -l -f "$ADMIN_KEYS" >/dev/null 2>&1; then
  have_key=yes
fi
[ "$have_key" = yes ] || fail \
  "no valid SSH public key in $ROOT_KEYS or $ADMIN_KEYS; recreate the container with --ssh-public-keys"

# APPDATA is a Proxmox-managed mount point on every profile. The container never
# formats, probes, or identifies a block device: if the mount is not already
# there, that is the host's job to fix.
mountpoint -q -- "$APPDATA_MOUNT" || fail \
  "$APPDATA_MOUNT is not a mount point; attach it on the host with 'pct set <ctid> --mp0 <storage>:<size>,mp=$APPDATA_MOUNT'"

#% if docker
# Nesting exposes a writable cgroup2 tree; without it the Docker daemon cannot
# create the container cgroups it needs.
[ -e /sys/fs/cgroup/cgroup.controllers ] || fail \
  "cgroup v2 is not available; create the container with features nesting=1"
#% endif

log "Preflight passed: unprivileged Debian $os_version LXC, APPDATA mounted, SSH key present"

# --- Timezone ----------------------------------------------------------------
# Set the files directly rather than going through timedatectl: the result is
# the same, and it does not depend on systemd-timedated answering on D-Bus.

[ -f "/usr/share/zoneinfo/$TIMEZONE" ] || fail "unknown timezone: $TIMEZONE"
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
printf '%s\n' "$TIMEZONE" | install_file /etc/timezone 0644
log "Timezone set to $TIMEZONE"

# --- APPDATA guard -----------------------------------------------------------
# One script, used by a boot-time unit on every profile and additionally as an
# ExecStartPre on the Docker units, so there is a single definition of what a
# usable APPDATA mount means.

install_file /usr/local/sbin/kasa-appdata-guard 0755 <<'EOF'
#!/bin/bash
# Refuse to continue unless the Proxmox-managed APPDATA mount is present and
# usable. Installed by the KASA LXC bootstrap.
set -Eeuo pipefail

mount_point='@@APPDATA_MOUNT@@'

guard_fail() { printf 'kasa-appdata-guard: %s\n' "$*" >&2; exit 1; }

mountpoint -q -- "$mount_point" || guard_fail "$mount_point is not mounted"

mount_count=$(findmnt --noheadings --output TARGET --mountpoint "$mount_point" | wc -l)
[ "$mount_count" -eq 1 ] || guard_fail \
  "expected exactly one mount at $mount_point, found $mount_count"

owner=$(stat -c '%U' "$mount_point")
[ "$owner" = root ] || guard_fail "$mount_point is owned by $owner, expected root"

mode=$(stat -c '%a' "$mount_point")
[ "$(( 0"$mode" & 0022 ))" -eq 0 ] || guard_fail \
  "$mount_point is group- or world-writable: $mode"

probe="$mount_point/.kasa-guard-probe.$$"
touch "$probe" || guard_fail "$mount_point is not writable"
rm -f "$probe"
EOF

install_file /etc/systemd/system/kasa-appdata-guard.service 0644 <<'EOF'
[Unit]
Description=Verify the KASA APPDATA mount point
RequiresMountsFor=@@APPDATA_MOUNT@@
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kasa-appdata-guard
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

/usr/local/sbin/kasa-appdata-guard
log "APPDATA guard installed and passing"

# --- Packages ----------------------------------------------------------------

install_file /etc/apt/apt.conf.d/80-kasa-retries 0644 <<'EOF'
Acquire::Retries "5";
Acquire::http::Timeout "30";
Acquire::https::Timeout "30";
DPkg::Lock::Timeout "120";
EOF

install_file /etc/apt/apt.conf.d/20auto-upgrades 0644 <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF

export DEBIAN_FRONTEND=noninteractive

log "Updating package lists"
apt-get update

# Before any third-party HTTPS repository is configured. The current container
# template ships CA certificates, so this is ordering for robustness rather than
# a fix, and it is the order Docker's own install instructions use.
apt-get install --yes --no-install-recommends ca-certificates

#% if docker
# Down before any package operation, not just before the Docker install. On a
# re-run Docker's repository is already on disk from the previous run, so the
# upgrade below can pull a new docker-ce or containerd.io -- and dpkg would
# restart the daemons against configuration this run is about to replace.
systemctl mask docker.service docker.socket containerd.service
# Masking prevents a start; it does not stop a unit that is already running.
# On a first run the units are simply absent, which is why this is conditional.
for unit in docker.socket docker.service containerd.service; do
  if systemctl is-active --quiet "$unit"; then
    systemctl stop "$unit"
  fi
done
#% endif

# The VM profiles do a full upgrade on first boot (package_update plus
# package_upgrade). The container template is pinned by hand and can be months
# old, so without this a finished bootstrap would sit on stale packages until
# unattended-upgrades got round to the subset it manages.
log "Upgrading the base system"
apt-get dist-upgrade --yes -o Dpkg::Options::=--force-confold

#% if docker
# Docker's own Debian repository, not Debian's older docker.io package.
# Release key fingerprint: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
install_file /etc/apt/keyrings/docker.asc 0644 <<'EOF'
@@DOCKER_GPG_KEY@@
EOF

install_file /etc/apt/sources.list.d/docker.sources 0644 <<'EOF'
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: trixie
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
EOF
#% endif

apt-get update

log "Installing packages"
apt-get install --yes --no-install-recommends \
  fail2ban \
  nftables \
  openssh-server \
  rsyslog \
  sudo \
  unattended-upgrades

#% if docker
# --- Docker storage, configured before the daemons ever run ------------------
# The units were masked and stopped before the system upgrade above, so nothing
# is running while these paths are set. Anything either daemon wrote to the
# container rootfs before being pointed at APPDATA would stay there, unused and
# invisible.

mkdir -p -- "$APPDATA_MOUNT/docker" "$APPDATA_MOUNT/containerd"
chmod 0710 -- "$APPDATA_MOUNT/docker"
chmod 0711 -- "$APPDATA_MOUNT/containerd"

install_file /etc/docker/daemon.json 0644 <<'EOF'
{
  "data-root": "@@APPDATA_MOUNT@@/docker",
  "log-driver": "journald",
  "log-opts": {
    "tag": "docker/{{.Name}}",
    "labels": "com.docker.compose.project,com.docker.compose.service"
  },
  "max-concurrent-downloads": 24,
  "max-concurrent-uploads": 8
}
EOF

log "Installing Docker Engine"
apt-get install --yes --no-install-recommends \
  containerd.io \
  docker-buildx-plugin \
  docker-ce \
  docker-ce-cli \
  docker-compose-plugin

# data-root does not move the containerd image store. Since Docker Engine 29 the
# containerd snapshotter is the default on a fresh install, and image content and
# snapshots live under containerd's own root. Setting only data-root would leave
# every pulled image filling the container rootfs.
containerd_default=$(mktemp)
containerd config default >"$containerd_default"
grep -qE '^root = ' "$containerd_default" \
  || fail "containerd's default config has no root setting to relocate"
sed -E "s|^root = .*|root = \"${APPDATA_MOUNT}/containerd\"|" "$containerd_default" \
  | install_file /etc/containerd/config.toml 0644
rm -f "$containerd_default"

install_file /etc/systemd/system/containerd.service.d/10-kasa-appdata.conf 0644 <<'EOF'
[Unit]
RequiresMountsFor=@@APPDATA_MOUNT@@

[Service]
ExecStartPre=/usr/local/sbin/kasa-appdata-guard
EOF

install_file /etc/systemd/system/docker.service.d/10-kasa-appdata.conf 0644 <<'EOF'
[Unit]
RequiresMountsFor=@@APPDATA_MOUNT@@

[Service]
ExecStartPre=/usr/local/sbin/kasa-appdata-guard
EOF

systemctl unmask docker.service docker.socket containerd.service
systemctl daemon-reload
systemctl enable containerd.service docker.socket docker.service
# restart, not `enable --now`: start is a no-op for a unit that is already
# active, so on a re-run the daemons would stay on the previous configuration
# while everything downstream reported the new one. restart also starts a unit
# that is not running yet, so it covers the first run too.
systemctl restart containerd.service
systemctl restart docker.service
log "Docker Engine installed"
#% endif

# --- admin user and SSH ------------------------------------------------------
# Order matters: admin must exist, hold a validated key, and have working sudo
# before the configuration that disables root login is loaded.

log "Creating the admin account"

if ! getent passwd admin >/dev/null; then
  useradd --create-home --shell /bin/bash --comment Admin admin
fi
usermod --shell /bin/bash --comment Admin --append --groups adm,sudo admin
if [ "$(passwd -S admin | awk '{print $2}')" != L ]; then
  usermod --lock admin
fi

install -d -m 0700 -o admin -g admin /home/admin/.ssh
install -d -m 0700 -o admin -g admin /home/admin/apps
chown admin:admin /home/admin
chmod 0700 /home/admin

# Merge root's Proxmox-supplied keys with anything admin already has, in order,
# without duplicates. A blind copy would silently discard a key added later.
key_work=$(mktemp -d)
: >"$key_work/all"
if [ -s "$ROOT_KEYS" ]; then
  cat "$ROOT_KEYS" >>"$key_work/all"
fi
if [ -s "$ADMIN_KEYS" ]; then
  cat "$ADMIN_KEYS" >>"$key_work/all"
fi
awk 'NF && $1 !~ /^#/ && !seen[$0]++' "$key_work/all" >"$key_work/keys"
[ -s "$key_work/keys" ] || fail "no SSH public keys available to install for admin"
ssh-keygen -l -f "$key_work/keys" >/dev/null \
  || fail "the collected SSH public keys did not validate"
install -m 0600 -o admin -g admin "$key_work/keys" "$ADMIN_KEYS"
rm -rf "$key_work"

printf '%s\n' 'admin ALL=(ALL) NOPASSWD:ALL' | install_file /etc/sudoers.d/90-admin 0440
visudo -cf /etc/sudoers.d/90-admin >/dev/null \
  || fail "the generated sudoers file did not validate"

[ "$(getent passwd admin | cut -d: -f7)" = /bin/bash ] || fail "admin's shell is not /bin/bash"
[ "$(passwd -S admin | awk '{print $2}')" = L ] || fail "admin's password is not locked"
id -nG admin | tr ' ' '\n' | grep -qx adm || fail "admin is not in the adm group"
id -nG admin | tr ' ' '\n' | grep -qx sudo || fail "admin is not in the sudo group"

log "Hardening sshd"

install_file /etc/ssh/sshd_config.d/99-harden.conf 0644 <<'EOF'
PasswordAuthentication no
PermitRootLogin no
@@SSH_ALLOW_USERS_DIRECTIVE@@
AuthenticationMethods publickey
KbdInteractiveAuthentication no
PermitUserEnvironment no
AllowAgentForwarding no
X11Forwarding no
PrintLastLog yes
MaxAuthTries 3
LoginGraceTime 30s
MaxSessions 5
MaxStartups 10:30:100
EOF

install -d -m 0755 /run/sshd
/usr/sbin/sshd -t || fail "the new sshd configuration is invalid; root access is unchanged"
systemctl enable ssh.service
systemctl reload-or-restart ssh.service
systemctl is-active --quiet ssh.service || fail "ssh.service is not running"

# Read the policy back from sshd itself rather than trusting the file we wrote.
sshd_effective=$(/usr/sbin/sshd -T)
printf '%s\n' "$sshd_effective" | grep -qx 'passwordauthentication no' \
  || fail "sshd still accepts password authentication"
printf '%s\n' "$sshd_effective" | grep -qx 'permitrootlogin no' \
  || fail "sshd still permits root login"
printf '%s\n' "$sshd_effective" | grep -qx 'pubkeyauthentication yes' \
  || fail "sshd does not accept public-key authentication"
log "sshd hardened; log in as admin from here on"

# --- sysctl ------------------------------------------------------------------
# Only keys the container actually owns. A container shares the host kernel, so
# kernel.*, fs.* and vm.* are read-only here; they are Proxmox host settings and
# are documented as such rather than being written and silently ignored.
# The filename must sort after Debian's 50-default.conf for rp_filter to stick.
#
# The conf.*.  entries are load-bearing, not decoration: for both redirect
# settings the kernel takes the OR of conf/all and conf/<interface>, so setting
# only all=0 would leave eth0 -- and docker0, created earlier by the daemon --
# accepting and sending redirects. Any interface created later inherits
# conf/default, which is why that is set too.

install_file /etc/sysctl.d/60-hardening.conf 0644 <<'EOF'
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.*.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.*.send_redirects = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.tcp_syncookies = 1
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.*.accept_redirects = 0
EOF

/usr/lib/systemd/systemd-sysctl

for entry in \
  net.ipv4.conf.all.accept_redirects=0 \
  net.ipv4.conf.default.accept_redirects=0 \
  net.ipv4.conf.all.send_redirects=0 \
  net.ipv4.conf.default.send_redirects=0 \
  net.ipv4.conf.all.rp_filter=1 \
  net.ipv4.conf.default.rp_filter=1 \
  net.ipv4.tcp_syncookies=1; do
  key=${entry%=*}
  want=${entry#*=}
  got=$(/usr/sbin/sysctl -n "$key")
  [ "$got" = "$want" ] || fail "$key is $got, expected $want"
done

# IPv6 may be compiled out or disabled on the host, in which case these keys do
# not exist to be set. That is a different thing from failing to apply them.
if [ -d /proc/sys/net/ipv6 ]; then
  for entry in \
    net.ipv6.conf.all.accept_redirects=0 \
    net.ipv6.conf.default.accept_redirects=0; do
    key=${entry%=*}
    want=${entry#*=}
    got=$(/usr/sbin/sysctl -n "$key")
    [ "$got" = "$want" ] || fail "$key is $got, expected $want"
  done
else
  warn "IPv6 is not available in this container; its redirect settings were not applied"
fi

# The aggregates being right does not make the interfaces right. Walk every
# interface that exists and confirm the value the kernel will actually use.
for family_dir in /proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf; do
  [ -d "$family_dir" ] || continue
  for interface_dir in "$family_dir"/*/; do
    interface=$(basename -- "$interface_dir")
    for leaf in accept_redirects send_redirects; do
      [ -f "$interface_dir$leaf" ] || continue
      got=$(cat -- "$interface_dir$leaf")
      [ "$got" = 0 ] || fail \
        "$(basename -- "$(dirname -- "$family_dir")")/$interface/$leaf is $got, expected 0"
    done
  done
done
# rp_filter needs no per-interface check: the kernel uses the maximum of
# conf/all and conf/<interface>, so all=1 already forces strict mode everywhere.
log "Container-owned sysctls applied and verified, including every interface"

# --- fail2ban ----------------------------------------------------------------

install_file /etc/fail2ban/jail.local 0644 <<'EOF'
[DEFAULT]
bantime = 30m
findtime = 15m
maxretry = 5
bantime.increment = true
bantime.factor = 4
bantime.overalljails = true
bantime.rndtime = 10m
backend = systemd
banaction = nftables-multiport
banaction_allports = nftables-allports
ignoreip = @@FAIL2BAN_IGNORE_IPS@@

[sshd]
enabled = true
port = ssh
filter = sshd[mode=aggressive]
EOF

#% if remote_syslog
# Keep ban state off disk to match the rest of the remote-logging profile: the
# collector is the durable copy, and bans do not survive a reboot.
install_file /etc/fail2ban/fail2ban.local 0644 <<'EOF'
[Definition]
logtarget = SYSTEMD-JOURNAL
dbfile = /run/fail2ban/fail2ban.sqlite3
EOF
#% endif

fail2ban-client -t >/dev/null || fail "the fail2ban configuration is invalid"
systemctl enable fail2ban.service
# The jail configuration was just rewritten. `enable --now` would not restart an
# already-running daemon, so on a re-run the ban proof below would exercise the
# previous policy and report it as the new one.
systemctl restart fail2ban.service
systemctl is-active --quiet fail2ban.service || fail "fail2ban.service is not running"

# The unit goes active before the server is ready to answer, so wait for it
# rather than racing the ban below.
fail2ban_ready=no
for _ in $(seq 1 30); do
  if fail2ban-client ping >/dev/null 2>&1; then
    fail2ban_ready=yes
    break
  fi
  sleep 1
done
[ "$fail2ban_ready" = yes ] || fail "fail2ban did not become ready"

# fail2ban that detects but cannot enforce is not a security control. Prove that
# a ban reaches nftables inside this container's network namespace instead of
# assuming it, and fail loudly if it does not.
probe_ban=192.0.2.1
fail2ban-client set sshd banip "$probe_ban" >/dev/null
ban_installed=no
for _ in $(seq 1 20); do
  if nft list ruleset 2>/dev/null | grep -qF "$probe_ban"; then
    ban_installed=yes
    break
  fi
  sleep 0.5
done
# Withdrawing the probe is cleanup, not a security control, so a jail that
# never accepted the ban is allowed to reject the unban too. The state is
# checked below either way.
fail2ban-client set sshd unbanip "$probe_ban" >/dev/null 2>&1 || true
[ "$ban_installed" = yes ] || fail \
  "fail2ban started but could not install an nftables ban; it would detect without blocking"
if nft list ruleset 2>/dev/null | grep -qF "$probe_ban"; then
  fail "the probe ban on $probe_ban is still installed; remove it before using this container"
fi
log "fail2ban active and enforcing bans through nftables"

systemctl enable --now unattended-upgrades.service
systemctl is-active --quiet unattended-upgrades.service \
  || fail "unattended-upgrades.service is not running"

# --- Logging -----------------------------------------------------------------

#% if remote_syslog
# This runs against a live container, not a template build boot, so an
# unreachable collector is fatal. Check it before switching the journal to
# memory: committing first would leave a container logging nowhere at all.
if ! timeout 5 bash -c "</dev/tcp/@@SYSLOG_SERVER@@/@@SYSLOG_PORT@@" 2>/dev/null; then
  fail "syslog collector @@SYSLOG_SERVER@@:@@SYSLOG_PORT@@ is unreachable; this profile has no local durable copy"
fi

install_file /etc/systemd/journald.conf.d/60-remote-syslog.conf 0644 <<'EOF'
[Journal]
Storage=volatile
RuntimeMaxUse=64M
ForwardToSyslog=no
RateLimitIntervalSec=30s
RateLimitBurst=5000
EOF

# imjournal needs /run/rsyslog before rsyslog starts, and rsyslog is
# socket-activated, so start ordering cannot be assumed. Preserve keeps the
# journal cursor across a restart; without it rsyslog re-forwards the whole
# journal to the collector.
install_file /etc/systemd/system/rsyslog.service.d/10-runtime-dir.conf 0644 <<'EOF'
[Service]
RuntimeDirectory=rsyslog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
EOF

install_file /etc/rsyslog.d/01-remote.conf 0644 <<'EOF'
# An absolute StateFile keeps the cursor out of Debian's $WorkDirectory, which
# is /var/spool/rsyslog. Overriding workDirectory globally from an included file
# would reach the whole daemon and degrade silently when the target is missing
# at startup, so leave it alone instead.
# Keep protection against journal replay loops and runaway producers, but use an
# explicit one-minute window suitable for container log bursts.
module(
  load="imjournal"
  StateFile="/run/rsyslog/imjournal.state"
  Ratelimit.Interval="60"
  Ratelimit.Burst="25000"
)

action(
  type="omfwd"
  target="@@SYSLOG_SERVER@@"
  port="@@SYSLOG_PORT@@"
  protocol="tcp"
  TCP_Framing="traditional"
  template="RSYSLOG_SyslogProtocol23Format"
  action.resumeRetryCount="-1"
  action.resumeInterval="30"
  # No queue.filename: naming a file is what makes a queue disk-assisted.
  # RAM is the only buffer, so an unreachable collector drops messages
  # rather than spooling them, lowest severity first.
  queue.type="LinkedList"
  queue.size="25000"
  queue.highWatermark="20000"
  queue.lowWatermark="5000"
  queue.timeoutEnqueue="0"
  queue.saveOnShutdown="off"
  queue.discardMark="24000"
  queue.discardSeverity="7"
)

# Do not continue into Debian's default on-disk /var/log actions.
stop
EOF

sed -i -E \
  's/^[[:space:]]*module\(load="imuxsock".*$/# disabled: using imjournal/; s/^[[:space:]]*module\(load="imklog".*$/# disabled: using imjournal/' \
  /etc/rsyslog.conf
if grep -qE '^[[:space:]]*module\(load="im(uxsock|klog)"' /etc/rsyslog.conf; then
  fail "imuxsock or imklog is still enabled in /etc/rsyslog.conf"
fi

systemctl restart systemd-journald.service
#% endif

/usr/sbin/rsyslogd -N1
systemctl enable rsyslog.service
systemctl restart rsyslog.service
systemctl is-active --quiet rsyslog.service || fail "rsyslog.service is not running"

#% if remote_syslog
# Catch a broken StateFile path or a missing runtime directory here rather than
# in production, where it would silently replay the journal.
[ -e /run/rsyslog/imjournal.state ] \
  || fail "imjournal did not create its state file under /run/rsyslog"
logger -t kasa-lxc-bootstrap "remote syslog forwarding smoke test"
log "Remote syslog forwarding to @@SYSLOG_SERVER@@:@@SYSLOG_PORT@@ verified"
#% endif
# --- Provenance --------------------------------------------------------------
# What produced this container's configuration. The container was bootstrapped
# after Proxmox created it; nothing here was baked into an image.

install_file /etc/kasa-lxc-release 0644 <<EOF
ID=$PROFILE_NAME
DESCRIPTION=$PROFILE_DESCRIPTION
RELEASE=$RELEASE
EXPECTED_LXC_TEMPLATE=$EXPECTED_LXC_TEMPLATE
DOCKER=$DOCKER_ENABLED
LOGGING=$LOGGING_MODE
SOURCE_COMMIT=$SOURCE_COMMIT
SOURCE_TREE_DIRTY=$SOURCE_TREE_DIRTY
RENDERED_AT=$RENDERED_AT
BOOTSTRAPPED_AT=$(date -u +%Y-%m-%dT%H:%M:%S+00:00)
EOF

# --- Verification ------------------------------------------------------------
# Re-check the resulting state. A bootstrap that printed no errors but left the
# container half-configured is the failure mode worth spending lines on.

log "Verifying the bootstrapped container"

systemctl is-enabled --quiet ssh.service || fail "ssh.service is not enabled at boot"
systemctl is-enabled --quiet fail2ban.service || fail "fail2ban.service is not enabled at boot"
systemctl is-enabled --quiet rsyslog.service || fail "rsyslog.service is not enabled at boot"
systemctl enable kasa-appdata-guard.service >/dev/null
# restart, not start: the unit is Type=oneshot with RemainAfterExit=yes, so on a
# re-run it is already active and start would return success without running the
# check again -- leaving the assertion below to pass without verifying anything.
systemctl restart kasa-appdata-guard.service
systemctl is-active --quiet kasa-appdata-guard.service \
  || fail "kasa-appdata-guard.service did not succeed"

if findmnt --noheadings --output FSTYPE --mountpoint /var/log 2>/dev/null \
    | grep -qx tmpfs; then
  fail "/var/log is backed by tmpfs; packages that create log directories would lose them"
fi

[ -s "$ADMIN_KEYS" ] || fail "admin has no authorized_keys"
[ "$(stat -c '%a' "$ADMIN_KEYS")" = 600 ] || fail "admin's authorized_keys is not mode 0600"
[ "$(stat -c '%a' /home/admin)" = 700 ] || fail "/home/admin is not mode 0700"
[ "$(stat -c '%a' /home/admin/.ssh)" = 700 ] || fail "/home/admin/.ssh is not mode 0700"

#% if docker
systemctl is-active --quiet containerd.service || fail "containerd.service is not running"
systemctl is-active --quiet docker.service || fail "docker.service is not running"
systemctl is-enabled --quiet docker.service || fail "docker.service is not enabled at boot"
systemctl is-enabled --quiet containerd.service || fail "containerd.service is not enabled at boot"

docker info >/dev/null || fail "docker info failed"
docker compose version >/dev/null || fail "the Docker Compose plugin is not available"

docker_root=$(docker info --format '{{.DockerRootDir}}')
[ "$docker_root" = "$APPDATA_MOUNT/docker" ] \
  || fail "Docker data-root is $docker_root, expected $APPDATA_MOUNT/docker"

# `containerd config dump` parses the config file; it does not ask the running
# daemon. Check both: that the file resolves to the right root, and that the
# running daemon actually populated it. The second is what would catch a daemon
# still serving an older configuration.
containerd_root=$(containerd config dump | sed -n "s/^root = ['\"]\(.*\)['\"]\$/\1/p" | head -n1)
[ "$containerd_root" = "$APPDATA_MOUNT/containerd" ] \
  || fail "containerd root is '$containerd_root', expected $APPDATA_MOUNT/containerd"
[ -n "$(ls -A -- "$APPDATA_MOUNT/containerd" 2>/dev/null)" ] \
  || fail "containerd is active but has not initialised its store under $APPDATA_MOUNT/containerd"

storage_driver=$(docker info --format '{{.Driver}}')
log "Docker storage driver: $storage_driver"

logging_driver=$(docker info --format '{{.LoggingDriver}}')
[ "$logging_driver" = journald ] \
  || fail "Docker logging driver is $logging_driver, expected journald"

# Nothing should have landed on the container rootfs. An existing but empty
# directory is fine; dpkg creates one.
for stray in /var/lib/docker /var/lib/containerd; do
  if [ -d "$stray" ] && [ -n "$(ls -A "$stray")" ]; then
    fail "$stray is populated; Docker or containerd state is on the container rootfs"
  fi
done

if [ "$RUN_DOCKER_SMOKE_TEST" != yes ]; then
  log "Docker smoke test not requested; pass --docker-smoke-test to run it"
else
  log "Running the Docker smoke test with $SMOKE_IMAGE"
  smoke_dir="$APPDATA_MOUNT/.kasa-smoke"
  rm -rf -- "$smoke_dir"
  mkdir -p -- "$smoke_dir"
  printf 'kasa-smoke\n' >"$smoke_dir/probe"

  docker rm -f kasa-smoke >/dev/null 2>&1 || true
  docker pull --quiet "$SMOKE_IMAGE" >/dev/null
  docker run --detach --name kasa-smoke \
    --memory 64m --cpus 0.5 \
    --volume "$smoke_dir:/probe:ro" \
    "$SMOKE_IMAGE" sleep 60 >/dev/null

  [ "$(docker exec kasa-smoke cat /probe/probe)" = kasa-smoke ] \
    || fail "the APPDATA bind mount was not readable inside the container"
  docker exec kasa-smoke nslookup deb.debian.org >/dev/null 2>&1 \
    || fail "container networking or DNS resolution does not work"

  # Read the limit from inside the container: this is what proves the cgroup
  # subtree Proxmox delegated is deep enough for Docker to constrain workloads.
  enforced_memory=$(docker exec kasa-smoke cat /sys/fs/cgroup/memory.max)
  [ "$enforced_memory" = 67108864 ] \
    || fail "the 64m memory limit was not enforced (cgroup delegation): got $enforced_memory"

  docker rm -f kasa-smoke >/dev/null
  docker rmi "$SMOKE_IMAGE" >/dev/null
  rm -rf -- "$smoke_dir"
  log "Docker smoke test passed: run, networking, APPDATA bind mount, memory limit"
fi
#% endif

apt-get autoremove --yes --purge >/dev/null
apt-get clean

trap - ERR

printf '\n'
log "Bootstrap complete for profile $PROFILE_NAME"
log "Provenance: /etc/kasa-lxc-release"
log "Log in as admin; root SSH login is disabled and passwords are not accepted."
#% if docker
if [ "$RUN_DOCKER_SMOKE_TEST" = yes ]; then
  log "Docker smoke test: PASSED ($SMOKE_IMAGE)"
else
  log "Docker smoke test: NOT RUN"
fi
#% endif
