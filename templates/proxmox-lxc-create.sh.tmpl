#!/bin/bash
# Create the KASA @@PROFILE_NAME@@ LXC container on Proxmox.
#
# Generated locally for one profile by tools/build.py. Copy it to a Proxmox node
# and run it as root, with the matching bootstrap script beside it.
#
# This script owns only what the host owns: the container's ID, resources,
# network, storage, SSH key, and LXC feature flags. Everything inside the
# container is the bootstrap's job.
set -Eeuo pipefail

CTID=@@CTID@@
HOSTNAME=@@HOSTNAME@@
DEFAULT_CTID="$CTID"
DEFAULT_HOSTNAME="$HOSTNAME"
NO_START=no
HWADDR=""
PROFILE_NAME=@@PROFILE_NAME@@
LXC_TEMPLATE=@@LXC_TEMPLATE@@
TEMPLATE_STORAGE=@@LXC_TEMPLATE_STORAGE@@
ROOTFS_STORAGE=@@LXC_ROOTFS_STORAGE@@
ROOT_DISK_SIZE=@@LXC_ROOT_DISK_SIZE@@
APPDATA_STORAGE=@@LXC_APPDATA_STORAGE@@
APPDATA_DISK_SIZE=@@LXC_APPDATA_DISK_SIZE@@
APPDATA_MOUNT=@@APPDATA_MOUNT@@
CPU=@@LXC_CPU@@
MEMORY=@@LXC_MEMORY@@
SWAP=@@LXC_SWAP@@
BRIDGE=@@BRIDGE@@
VLAN_TAG=@@LXC_VLAN_TAG@@
NAMESERVER=@@LXC_NAMESERVER@@
TIMEZONE=@@TIMEZONE@@
#% if ssh_public_key
SSH_PUBLIC_KEY=@@SSH_PUBLIC_KEY@@
#% endif
BOOTSTRAP_NAME=@@BOOTSTRAP_NAME@@
BOOTSTRAP_SHA256=@@BOOTSTRAP_SHA256@@

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  printf '%s\n' \
    "Usage: $0 [--ctid ID] [--hostname NAME] [--hwaddr MAC] [--no-start]" \
    '' \
    "Creates a container for the KASA $PROFILE_NAME profile." \
    "Defaults: --ctid $DEFAULT_CTID --hostname $DEFAULT_HOSTNAME" \
    '' \
    'Override both to provision more than one container from this profile.' \
    '' \
    '--hwaddr MAC  Give net0 this MAC address instead of a random one. Six' \
    '              colon-separated hex octets; multicast and all-zero are refused.' \
    '--no-start    Create and check the container but leave it stopped, and do not' \
    '              upload the bootstrap. Prints the commands that finish the job,' \
    '              so the guest firewall can be written before the first start.' \
    '              The container is created with onboot 0, so a host reboot does' \
    '              not start it either; set onboot 1 once its firewall exists.' \
    '' \
    'There is no --replace: an existing container ID is an error, and removing' \
    'a container stays a deliberate action you take yourself.'
}

while [ "$#" -gt 0 ]; do
  case $1 in
    --ctid) CTID=${2:?--ctid needs a container ID}; shift 2 ;;
    --hostname) HOSTNAME=${2:?--hostname needs a name}; shift 2 ;;
    --hwaddr) HWADDR=${2:?--hwaddr needs a MAC address}; shift 2 ;;
    --no-start) NO_START=yes; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

# A container created with --no-start must not start at host boot either: until
# its guest firewall exists, a reboot of the node would bring it up unprotected.
# The caller sets onboot 1 once the firewall is written and the container runs.
case $NO_START in
  yes) ONBOOT=0 ;;
  *) ONBOOT=1 ;;
esac

case $CTID in
  ''|*[!0-9]*) fail "container ID must be a positive integer: $CTID" ;;
esac
[ "$CTID" -ge 100 ] || fail "Proxmox reserves container IDs below 100: $CTID"
# Proxmox derives the container's hostname from this, so reject anything it
# would turn into a different name than the one asked for.
printf '%s' "$HOSTNAME" \
  | grep -qE '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$' \
  || fail "not a valid hostname: $HOSTNAME"

# A fixed MAC is what lets a DHCP reservation and the guest firewall be planned
# before the container exists. Proxmox would accept a multicast or all-zero
# address and the guest would then never get a lease, so refuse both here.
if [ -n "$HWADDR" ]; then
  [[ $HWADDR =~ ^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$ ]] \
    || fail "not a MAC address (six colon-separated hex octets): $HWADDR"
  HWADDR=$(printf '%s' "$HWADDR" | tr '[:lower:]' '[:upper:]')
  [ "$HWADDR" != 00:00:00:00:00:00 ] || fail "the all-zero MAC address is not usable"
  [ $((16#${HWADDR%%:*} & 1)) -eq 0 ] \
    || fail "$HWADDR is a multicast MAC address (low bit of the first octet is set)"
fi

[ "$(id -u)" -eq 0 ] || fail "run this on the Proxmox node as root"

for required in awk pct pvesm pveam sha256sum ssh-keygen; do
  command -v "$required" >/dev/null || fail "required command is missing: $required"
done

# No --replace. Destroying a container is not something a generated script
# should be able to do by accident, and a wrong CTID here would be someone
# else's workload.
if pct config "$CTID" >/dev/null 2>&1; then
  fail "container $CTID already exists; pass --ctid for a different one, or remove it yourself"
fi

# Report the storages that would work, rather than only the one that does not.
# Only active ones: suggesting an offline target would just move the failure.
storages_supporting() {
  pvesm status --content "$1" 2>/dev/null \
    | awk 'NR > 1 && $3 == "active" {print $1}' | paste -sd' ' -
}

require_storage() {
  local storage=$1 content=$2 role=$3 status
  pvesm status --storage "$storage" >/dev/null 2>&1 \
    || fail "$role storage is not defined on this node: $storage"

  # Defined is not the same as usable. pvesm exits 0 for a storage that is
  # disabled or whose backing device is offline, so read the status column.
  status=$(pvesm status --storage "$storage" 2>/dev/null | awk 'NR > 1 {print $3; exit}')
  [ "$status" = active ] || fail "$(printf '%s\n' \
    "$role storage '$storage' is not active (status: ${status:-unknown})." \
    "Enable it, or bring its backing device online, before creating the container." \
    "Active storages accepting '$content': $(storages_supporting "$content")")"

  if ! pvesm status --storage "$storage" --content "$content" >/dev/null 2>&1; then
    fail "$(printf '%s\n' \
      "$role storage '$storage' does not accept '$content' content." \
      "On a standard install 'local' holds only iso, vztmpl and backup, so it" \
      "cannot hold a container rootfs or mount point volume." \
      "Active storages on this node that accept '$content': $(storages_supporting "$content")" \
      "Set the matching LXC_*_STORAGE in tools/.env and rebuild.")"
  fi
}

require_storage "$TEMPLATE_STORAGE" vztmpl "template"
require_storage "$ROOTFS_STORAGE" rootdir "rootfs"
require_storage "$APPDATA_STORAGE" rootdir "APPDATA"

# The bootstrap is optional here: it can be run later against any compatible
# container. When it is present, verify it before it goes anywhere near the CT.
bootstrap_path="$script_dir/$BOOTSTRAP_NAME"
have_bootstrap=no
if [ -f "$bootstrap_path" ]; then
  printf '%s  %s\n' "$BOOTSTRAP_SHA256" "$bootstrap_path" | sha256sum --check - >/dev/null \
    || fail "$BOOTSTRAP_NAME does not match the checksum recorded at build time"
  have_bootstrap=yes
fi

# Guarded the same way the VM script guards its own temp file, because a CA-only
# build injects no key at all and there is then nothing to remove.
ssh_key_file=""
cleanup() { [ -z "$ssh_key_file" ] || rm -f "$ssh_key_file"; }
trap cleanup EXIT
#% if ssh_public_key
ssh_key_file=$(mktemp --suffix=.pub "/root/kasa-ct-${CTID}-key.XXXXXXXX")
chmod 0600 "$ssh_key_file"
# One key per line. ssh-keygen -l reports every key in the file, so one call
# validates all of them.
printf '%s\n' "$SSH_PUBLIC_KEY" >"$ssh_key_file"
ssh-keygen -l -f "$ssh_key_file" >/dev/null \
  || fail "the built-in SSH public keys are not valid"
#% endif

# Proxmox verifies the appliance catalogue signature and the downloaded template
# against it, so there is no separate checksum to carry here.
pveam update >/dev/null
template_volume="${TEMPLATE_STORAGE}:vztmpl/${LXC_TEMPLATE}"
if ! pvesm list "$TEMPLATE_STORAGE" --content vztmpl | awk '{print $1}' \
    | grep -qxF "$template_volume"; then
  printf 'Downloading container template %s\n' "$LXC_TEMPLATE"
  pveam download "$TEMPLATE_STORAGE" "$LXC_TEMPLATE"
fi

net0="name=eth0,bridge=${BRIDGE},firewall=1,ip=dhcp"
if [ -n "$VLAN_TAG" ]; then
  net0="${net0},tag=${VLAN_TAG}"
fi
if [ -n "$HWADDR" ]; then
  net0="${net0},hwaddr=${HWADDR}"
fi

# Only pass --nameserver when one is configured; with no value Proxmox inherits
# the host's resolver, which is the right default for a DHCP container.
optional_args=()
if [ -n "$NAMESERVER" ]; then
  optional_args+=(--nameserver "$NAMESERVER")
fi

printf 'Creating container %s (%s)\n' "$CTID" "$HOSTNAME"
# APPDATA is a Proxmox-managed mount point on every profile. The container never
# formats or identifies a block device; the host owns the volume.
pct create "$CTID" "$template_volume" \
  --hostname "$HOSTNAME" \
  --ostype debian \
  --unprivileged 1 \
#% if docker
  --features keyctl=1,nesting=1 \
#% endif
  --rootfs "${ROOTFS_STORAGE}:${ROOT_DISK_SIZE}" \
  --mp0 "${APPDATA_STORAGE}:${APPDATA_DISK_SIZE},mp=${APPDATA_MOUNT},backup=1" \
  --cores "$CPU" \
  --memory "$MEMORY" \
  --swap "$SWAP" \
  --net0 "$net0" \
  --timezone "$TIMEZONE" \
#% if ssh_public_key
  --ssh-public-keys "$ssh_key_file" \
#% endif
  --onboot "$ONBOOT" \
  --start 0 \
  "${optional_args[@]}"

# --- Post-create checks ------------------------------------------------------
# Read the properties back rather than comparing the whole features line to a
# string: Proxmox is free to reorder or normalise it, and what matters is which
# capabilities are on, not how the line is spelled.

config=$(pct config "$CTID")
features=$(printf '%s\n' "$config" | sed -n 's/^features: //p')

has_feature() {
  printf '%s' "$features" | tr ',' '\n' | grep -qx "$1"
}

printf '%s\n' "$config" | grep -qx 'unprivileged: 1' \
  || fail "container $CTID is not unprivileged"

for forbidden in fuse=1 mknod=1; do
  if has_feature "$forbidden"; then
    fail "container $CTID has $forbidden, which this profile does not use"
  fi
done
if printf '%s' "$features" | tr ',' '\n' | grep -q '^mount='; then
  fail "container $CTID may mount filesystems, which this profile does not use"
fi
if printf '%s\n' "$config" | grep -qi 'apparmor'; then
  fail "container $CTID carries an AppArmor override; this profile stays confined"
fi

mp_count=$(printf '%s\n' "$config" | awk '/^mp[0-9]+:/ {n++} END {print n+0}')
[ "$mp_count" -eq 1 ] || fail "expected exactly one mount point, found $mp_count"
# Compare whole comma-separated options rather than matching a substring, so a
# different mount point that merely starts with the same path cannot pass.
mp0_options=$(printf '%s\n' "$config" | sed -n 's/^mp0: //p')
printf '%s\n' "$mp0_options" | tr ',' '\n' | grep -qx "mp=${APPDATA_MOUNT}" \
  || fail "mp0 is not mounted at $APPDATA_MOUNT"

#% if docker
# Docker needs exactly these two, and nothing beyond them. keyctl lets the
# daemon use the kernel keyring from inside a user namespace; nesting exposes
# procfs and sysfs so it can start containers of its own.
has_feature keyctl=1 || fail "container $CTID is missing keyctl=1, which Docker needs"
has_feature nesting=1 || fail "container $CTID is missing nesting=1, which Docker needs"
#% endif

# Proxmox omits a false onboot from the config, so an absent line reads as 0.
onboot=$(printf '%s\n' "$config" | sed -n 's/^onboot: //p')
[ "${onboot:-0}" = "$ONBOOT" ] \
  || fail "container $CTID has onboot '${onboot:-0}', expected $ONBOOT"

if [ -n "$HWADDR" ]; then
  net0_hwaddr=$(printf '%s\n' "$config" | sed -n 's/^net0: //p' \
    | tr ',' '\n' | sed -n 's/^hwaddr=//p')
  [ "$net0_hwaddr" = "$HWADDR" ] \
    || fail "net0 of container $CTID has hwaddr '${net0_hwaddr:-none}', expected $HWADDR"
fi

# --no-start stops here, before the first boot, so the caller can write the
# guest firewall first. The bootstrap is not uploaded either: pct push works by
# entering the container's namespaces through its running init process, and
# Proxmox refuses it for a stopped container ("can only push files to a running
# container"). Print the rest of the sequence instead.
if [ "$NO_START" = yes ]; then
  printf '\nCreated container %s (%s) for profile %s; not started (--no-start)\n' \
    "$CTID" "$HOSTNAME" "$PROFILE_NAME"
  if [ "$have_bootstrap" != yes ]; then
    printf '%s was not found beside this script; copy it to %s first.\n' \
      "$BOOTSTRAP_NAME" "$bootstrap_path"
  fi
  printf 'It has onboot 0, so a host reboot will not start it before its firewall exists.\n'
  printf 'Finish it by running these on this node, in order:\n\n'
  printf '  pct start %s\n' "$CTID"
  # shellcheck disable=SC2016 # printed for the operator to run, not expanded here
  printf '  until [ "$(pct status %s)" = "status: running" ]; do sleep 1; done\n' "$CTID"
  printf '  pct set %s --onboot 1   # only once its guest firewall exists\n' "$CTID"
  printf '  pct push %s %q /root/%s --perms 0755\n' "$CTID" "$bootstrap_path" "$BOOTSTRAP_NAME"
  printf '  pct exec %s -- /root/%s\n\n' "$CTID" "$BOOTSTRAP_NAME"
  printf 'The bootstrap creates the admin account and disables root SSH login.\n'
  exit 0
fi

printf 'Starting container %s\n' "$CTID"
pct start "$CTID"
for _ in $(seq 1 30); do
  if [ "$(pct status "$CTID")" = "status: running" ]; then
    break
  fi
  sleep 1
done
[ "$(pct status "$CTID")" = "status: running" ] || fail "container $CTID did not start"

printf '\nCreated container %s (%s) for profile %s\n' "$CTID" "$HOSTNAME" "$PROFILE_NAME"

if [ "$have_bootstrap" = yes ]; then
  pct push "$CTID" "$bootstrap_path" "/root/$BOOTSTRAP_NAME" --perms 0755
  printf 'Bootstrap uploaded. Complete the container with:\n\n'
  printf '  pct exec %s -- /root/%s\n\n' "$CTID" "$BOOTSTRAP_NAME"
else
  printf 'Copy %s into the container and run it as root to complete setup.\n\n' \
    "$BOOTSTRAP_NAME"
fi
printf 'The bootstrap creates the admin account and disables root SSH login.\n'
